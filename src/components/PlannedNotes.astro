---
// The notes a dedicated series holds, as the plans list them.
//
// These series are undated (series.ts `undated: true`): a note goes live as
// soon as its file is merged, with no day and no place in the timeline. A
// row links to its note once the file exists in the blog collection, and
// says "not written yet" until then, with the hollow "ahead" marker, so the
// site never claims a note that is not written.
import { getCollection } from 'astro:content';
import type { Series } from '../data/series';
import { planById, planGroups } from '../data/plans';
import { noteHref } from '../utils/notes';

interface Props {
  series: Series;
  /** Only the rows that come from this plan. */
  plan?: string;
}

const { series: s, plan } = Astro.props;
const posts = await getCollection('blog');

const groupName = (planId: string) => {
  const found = planById(planId);
  return found ? planGroups.find((g) => g.id === found.group)!.name : planId;
};

const rows = (s.planned ?? [])
  .map((note, index) => {
    const written = posts.find(
      (post) => post.data.series === s.id && post.data.seriesOrder === index + 1,
    );
    return {
      ...note,
      number: String(index + 1).padStart(2, '0'),
      href: written ? noteHref(written) : undefined,
      readTime: written?.data.readTime,
    };
  })
  .filter((note) => !plan || note.plan === plan);
const writtenCount = rows.filter((row) => row.href).length;
---

{rows.length > 0 ? (
  <ol
    class="journey"
    aria-label={writtenCount === rows.length
      ? `Notes in ${s.name}`
      : `Notes in ${s.name}, ${writtenCount} of ${rows.length} written`}
  >
    {rows.map((note) => (
      <li class={note.href ? 'past' : 'ahead'}>
        <p class="when">
          {note.number} · {note.href ? note.readTime : 'not written yet'}
          {note.plan && (
            <span class="state">{groupName(note.plan)}, phase {note.phase}</span>
          )}
        </p>
        <p class="post">
          {note.href ? <a href={note.href}>{note.title}</a> : note.title}
        </p>
      </li>
    ))}
  </ol>
) : s.plannedNote ? (
  <p class="series-note">{s.plannedNote}</p>
) : null}
