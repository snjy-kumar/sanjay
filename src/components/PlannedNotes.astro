---
// The notes a planned series will hold, as the plans list them.
//
// None of these is written or dated, so none of them is a link and none of
// them has a date: each row says "not scheduled" where a published row
// would carry its date, and uses the hollow "ahead" marker. A row moves out
// of here only when the note is scheduled in series.ts.
import type { Series } from '../data/series';
import { planById, planGroups } from '../data/plans';

interface Props {
  series: Series;
  /** Only the rows that come from this plan. */
  plan?: string;
}

const { series: s, plan } = Astro.props;

const groupName = (planId: string) => {
  const found = planById(planId);
  return found ? planGroups.find((g) => g.id === found.group)!.name.toLowerCase() : planId;
};

const rows = (s.planned ?? [])
  .map((note, index) => ({ ...note, number: String(index + 1).padStart(2, '0') }))
  .filter((note) => !plan || note.plan === plan);
---

{rows.length > 0 ? (
  <ol class="journey" aria-label={`Notes planned for ${s.name}, not written yet`}>
    {rows.map((note) => (
      <li class="ahead">
        <p class="when">
          {note.number} · not scheduled
          {note.plan && (
            <span class="state">{groupName(note.plan)}, phase {note.phase}</span>
          )}
        </p>
        <p class="post">{note.title}</p>
      </li>
    ))}
  </ol>
) : s.plannedNote ? (
  <p class="series-note">{s.plannedNote}</p>
) : null}
