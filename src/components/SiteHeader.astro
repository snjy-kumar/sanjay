---
import { profile } from '../data/site';
import { withBase } from '../utils/base';
---

<header class="top">
  <div class="top-brand">
    <p class="name"><a href={withBase('/')}>{profile.name}</a></p>
    <p class="where">{profile.role} · {profile.location} <span id="clock"></span></p>
  </div>
  <nav class="top-nav" aria-label="Main navigation">
    <a href={withBase('/#work')}>Work</a>
    <a href={withBase('/posts/')}>Notes</a>
    <a href={withBase('/path/')}>Curriculum</a>
    <button type="button" class="nav-search-btn" data-open-search aria-label="Search site (Cmd+K)">
      <svg class="search-nav-ico" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle>
        <path d="M10.5 10.5L14 14"></path>
      </svg>
      <span>Search</span>
      <kbd>⌘K</kbd>
    </button>
    <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
  </nav>
</header>

<script>
  (function () {
    const w = window as any;

    function tick() {
      const clock = document.getElementById('clock');
      if (!clock) return;
      const time = new Intl.DateTimeFormat('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
        timeZone: 'Asia/Kolkata',
      }).format(new Date());
      clock.textContent = '· ' + time;
    }

    function start() {
      tick();
      if (!w.__clockInterval) {
        w.__clockInterval = setInterval(tick, 30000);
      }
    }

    start();
    if (!w.__clockHooked) {
      w.__clockHooked = true;
      document.addEventListener('astro:page-load', start);
    }
  })();
</script>
