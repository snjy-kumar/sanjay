---
// A row of boxes joined by arrows: a pipeline, a sequence of states, a
// request path. Text only; wraps on a narrow screen.
interface Props {
  steps: string[];
  caption: string;
}
const { steps, caption } = Astro.props;
---

<figure class="dia dia-flow">
  <ol>
    {steps.map((step) => <li>{step}</li>)}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>
