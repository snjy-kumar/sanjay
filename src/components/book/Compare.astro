---
// Two columns side by side: wrong and right, before and after, C and
// TypeScript. Each column is a list of short lines.
interface Props {
  left: string;
  right: string;
  rows: [string, string][];
  caption: string;
}
const { left, right, rows, caption } = Astro.props;
---

<figure class="dia dia-compare">
  <table>
    <thead><tr><th scope="col">{left}</th><th scope="col">{right}</th></tr></thead>
    <tbody>
      {rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}
    </tbody>
  </table>
  <figcaption>{caption}</figcaption>
</figure>
