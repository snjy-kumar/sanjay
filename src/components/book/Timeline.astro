---
// A vertical timeline: a reading schedule, the life of an object, the
// order things happen in.
interface Props {
  items: { when: string; what: string }[];
  caption: string;
}
const { items, caption } = Astro.props;
---

<figure class="dia dia-timeline">
  <ol>
    {items.map((item) => <li><span class="dia-when">{item.when}</span><span class="dia-what">{item.what}</span></li>)}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>
