---
// Stacked boxes, top to bottom: an abstraction stack, a memory layout, the
// layers a call passes through.
interface Props {
  layers: { name: string; note?: string }[];
  caption: string;
}
const { layers, caption } = Astro.props;
---

<figure class="dia dia-layers">
  <ol>
    {layers.map((layer) => (
      <li><span class="dia-name">{layer.name}</span>{layer.note && <span class="dia-note">{layer.note}</span>}</li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>
