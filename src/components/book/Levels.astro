---
// The level progression for one chapter or one plan phase. Its children are
// nine <Level> blocks, Beginner to Strategy, in the order of
// src/data/levels.ts. The ladder at the top is a map of the nine steps; the
// build check reads the data-level attributes to enforce the order.
import { levels } from '../../data/levels';

interface Props {
  /** What the progression is about, for screen readers: "Chapter 11, Pointers". */
  label: string;
}

const { label } = Astro.props;
---

<div class="levels" role="group" aria-label={`${label}: nine levels, beginner to strategy`}>
  <ol class="level-ladder" aria-hidden="true">
    {levels.map((level, index) => (
      <li><span class="level-n">{index + 1}</span>{level.name}</li>
    ))}
  </ol>
  <slot />
</div>
