---
// A text diagram drawn with box characters, in a <pre>. Pass the drawing as
// `art` so whitespace survives MDX untouched.
interface Props {
  art: string;
  caption: string;
}
const { art, caption } = Astro.props;
---

<figure class="dia dia-art">
  <pre aria-label={caption}>{art.replace(/^\n/, '').replace(/\s+$/, '')}</pre>
  <figcaption>{caption}</figcaption>
</figure>
