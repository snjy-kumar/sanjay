---
// A step-by-step trace: one row per step of an algorithm or a program, one
// column per thing that changes (a variable, the array, the stack). For
// "watch it run" tables on chapter pages. Cells are short text; put code in
// backticks in the caption, not in the cells.
interface Props {
  /** Column headings, e.g. ["step", "key", "array"]. */
  columns: string[];
  /** One row per step; each row has one cell per column. */
  rows: string[][];
  caption: string;
}
const { columns, rows, caption } = Astro.props;
for (const row of rows) {
  if (row.length !== columns.length) {
    throw new Error(`Trace "${caption}": a row has ${row.length} cells, expected ${columns.length}.`);
  }
}
---

<figure class="dia dia-trace">
  <table>
    <thead><tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
    <tbody>
      {rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
    </tbody>
  </table>
  <figcaption>{caption}</figcaption>
</figure>
