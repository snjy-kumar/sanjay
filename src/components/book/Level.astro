---
// One step of a <Levels> progression. `name` must be one of the nine level
// names; an unknown name stops the build.
import { levelByName, levels } from '../../data/levels';

interface Props {
  name: string;
  /** Heading level: 4 under a chapter (h3), 3 under a plan phase (h2). */
  depth?: 3 | 4;
}

const { name, depth = 4 } = Astro.props;
const level = levelByName(name);
const n = levels.findIndex((entry) => entry.name === level.name) + 1;
const Heading = depth === 3 ? 'h3' : 'h4';
---

<section class="level" data-level={level.id}>
  <Heading class="level-name"><span class="level-n">{n}/9</span> {level.name}</Heading>
  <div class="level-body">
    <slot />
  </div>
</section>
