---
// One plan's phases as a table: what each phase must produce, where its
// notes will go, and which published notes already cover part of it.
//
// A series links to its page once it has one; until then it links to its
// planned list on the path page. A track links to its row on the path page.
// A note id only appears once the note is published.
import type { CollectionEntry } from 'astro:content';
import type { Plan } from '../data/plans';
import { roadmap } from '../data/roadmap';
import { withBase } from '../utils/base';
import { noteHref, seriesName, publishedIn } from '../utils/notes';

interface Props {
  plan: Plan;
  posts: CollectionEntry<'blog'>[];
}

const { plan, posts } = Astro.props;

const trackName = (id: string) => roadmap.find((t) => t.id === id)?.name ?? id;

const rows = plan.phases.map((phase) => ({
  phase,
  destinations: [
    ...phase.series.map((id) => ({
      label: seriesName(id),
      href: publishedIn(posts, id) > 0 ? withBase(`/posts/${id}/`) : withBase(`/path/#series-${id}`),
    })),
    ...phase.tracks.map((id) => ({ label: trackName(id), href: withBase(`/path/#track-${id}`) })),
  ],
  notes: [...new Set(phase.notes)]
    .map((id) => posts.find((post) => post.id === id))
    .filter((note): note is CollectionEntry<'blog'> => Boolean(note)),
}));
---

<div class="entry plan">
  <table>
    <thead>
      <tr>
        <th scope="col">{plan.group === 'books' ? '#' : plan.unit === 'Week' ? 'Lens' : 'Phase'}</th>
        <th scope="col">{plan.unit}</th>
        <th scope="col">{plan.group === 'books' ? 'Read' : 'Focus'}</th>
        <th scope="col">{plan.gateLabel}</th>
        <th scope="col">Notes go to</th>
        <th scope="col">Published so far</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ phase, destinations, notes }) => (
        <tr>
          <td>{phase.n}</td>
          <td>{phase.when}</td>
          <td>{phase.focus}</td>
          <td>
            {phase.gate}
            {phase.check && (
              <>
                <br />
                <em>Gate {phase.n}:</em> {phase.check}
              </>
            )}
          </td>
          <td>
            {destinations.length === 0
              ? '—'
              : destinations.map((d, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={d.href}>{d.label}</a>
                  </>
                ))}
          </td>
          <td>
            {notes.length === 0
              ? '—'
              : notes.map((note, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={noteHref(note)} title={note.data.title}>
                      {seriesName(note.data.series)} {String(note.data.seriesOrder).padStart(2, '0')}
                    </a>
                  </>
                ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
