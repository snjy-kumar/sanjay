---
import { Code } from 'astro:components';

interface Props {
  filename: string;
  code: string;
  lang?: string;
}

const { filename, code, lang = 'ts' } = Astro.props;
---

<div class="codeblock">
  <div class="codeblock-label">
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="#555" stroke-width="1.2"><path d="M2.5 1.5h5L10 4v6.5H2.5z"/><path d="M7.5 1.5V4H10"/></svg>
    {filename}
  </div>
  <Code code={code} lang={lang} theme="min-light" />
</div>

<style>
  .codeblock :global(pre) {
    margin: 0;
    padding: 10px 14px;
    overflow-x: auto;
    background: transparent !important;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    line-height: 1.55;
  }
  .codeblock :global(code) {
    font-family: inherit;
    font-size: inherit;
  }
</style>
