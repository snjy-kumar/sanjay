---
import { profile, profileLinks } from '../data/site';
import { withBase } from '../utils/base';

const siteNav = [
  { label: 'All Notes', href: withBase('/posts/') },
  { label: 'Curriculum', href: withBase('/path/') },
  { label: 'Topics', href: withBase('/topics/') },
  { label: 'Feed', href: withBase('/rss.xml') },
];
---

<footer>
  {profile.buttondown && (
    <form
      class="subscribe"
      action={`https://buttondown.email/api/emails/embed-subscribe/${profile.buttondown}`}
      method="post"
      target="popupwindow"
    >
      <label for="subscribe-email">Each new note, by email</label>
      <input
        id="subscribe-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <button type="submit">Subscribe</button>
      <p class="subscribe-note">
        No tracking, no newsletter. Unsubscribe in one click.
      </p>
    </form>
  )}
  <nav aria-label="Elsewhere">
    {profileLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <nav aria-label="Site index">
    {siteNav.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <p>Notes on React, TypeScript and JavaScript. Built with Astro.</p>
</footer>
