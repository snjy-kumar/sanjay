---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { series } from '../data/series';
import { profile } from '../data/site';
import { withBase } from '../utils/base';
import { markFor } from '../data/seriesMarks';
import { topicBySlug } from '../data/tags';
import { topicHref } from '../utils/notes';

interface Props {
  title: string;
  series: string;
  seriesOrder: number;
  date: Date;
  readTime: string;
  description?: string;
  currentSlug: string;
  tags?: string[];
  source?: string;
  related?: { slug: string; series: string; title: string }[];
  prevPost: { slug: string; title: string; series: string } | null;
  nextPost: { slug: string; title: string; series: string } | null;
}

const {
  title,
  series: postSeries,
  seriesOrder,
  date,
  readTime,
  description,
  currentSlug,
  tags = [],
  source,
  prevPost,
  nextPost,
} = Astro.props;

const fullDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formattedDateFull = fullDateFormatter.format(date);

const blogPosts = await getCollection('blog');
const inSeries = blogPosts
  .filter((post) => post.data.series === postSeries)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);

const seriesById = Object.fromEntries(series.map((s) => [s.id, s]));
const currentSeries = seriesById[postSeries] ?? {
  id: postSeries,
  name: postSeries.charAt(0).toUpperCase() + postSeries.slice(1),
  description: '',
};

const positionInSeries = inSeries.findIndex((p) => p.id.endsWith(`/${currentSlug}`)) + 1 || seriesOrder;
const seriesTotal = inSeries.length;

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const homeUrl = new URL(withBase('/'), siteOrigin).href;
const ogImageUrl = new URL(withBase(`/og/${postSeries}/${currentSlug}.png`), siteOrigin).href;
const prevUrl = prevPost
  ? new URL(withBase(`/posts/${prevPost.series}/${prevPost.slug}/`), siteOrigin).href
  : undefined;
const nextUrl = nextPost
  ? new URL(withBase(`/posts/${nextPost.series}/${nextPost.slug}/`), siteOrigin).href
  : undefined;
const publishedIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description ? { description } : {}),
  datePublished: publishedIso,
  dateModified: publishedIso,
  inLanguage: 'en',
  articleSection: currentSeries.name,
  image: ogImageUrl,
  author: { '@type': 'Person', name: profile.name, url: homeUrl },
  publisher: { '@type': 'Person', name: profile.name, url: homeUrl },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, siteOrigin).href,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="post-page"
  ogImage={ogImageUrl}
  ogImageAlt={`${currentSeries.name} note: ${title}`}
  jsonLd={jsonLd}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main" class="post-shell">
    <article class="post-content">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span class="sep">/</span>
        <a href={withBase('/posts/')}>Notes</a>
        <span class="sep">/</span>
        <a href={withBase(`/posts/${postSeries}/`)}>{currentSeries.name}</a>
        <span class="sep">/</span>
        <span aria-current="page">Note {String(positionInSeries).padStart(2, '0')}</span>
      </nav>

      <header class="post-header">
        <p class="post-series-kicker">
          <a href={withBase(`/posts/${postSeries}/`)}>
            <svg class="series-mark" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={markFor(postSeries)} />
            </svg>
            <span>{currentSeries.name} Series · Note {String(positionInSeries).padStart(2, '0')} of {seriesTotal}</span>
          </a>
        </p>
        <h1 class="note-title">{title}</h1>
        <p class="note-meta">{formattedDateFull} · {readTime} · Published</p>
      </header>

      <div class="note-body">
        <slot />
      </div>

      <footer class="post-footer">
        <nav class="post-pager" aria-label="Series navigation">
          {prevPost ? (
            <a class="pager-card prev" href={withBase(`/posts/${prevPost.series}/${prevPost.slug}/`)}>
              <span class="pager-dir">← Previous Note</span>
              <span class="pager-title">{prevPost.title}</span>
            </a>
          ) : (
            <div class="pager-card placeholder">
              <span class="pager-dir">Start of Series</span>
              <span class="pager-title">First note in {currentSeries.name}</span>
            </div>
          )}
          {nextPost ? (
            <a class="pager-card next" href={withBase(`/posts/${nextPost.series}/${nextPost.slug}/`)}>
              <span class="pager-dir">Next Note →</span>
              <span class="pager-title">{nextPost.title}</span>
            </a>
          ) : (
            <div class="pager-card placeholder">
              <span class="pager-dir">Series In Progress</span>
              <span class="pager-title">Latest published note</span>
            </div>
          )}
        </nav>

        <div class="post-meta-footer">
          <div class="post-meta-row">
            <span class="meta-label">Series:</span>
            <a href={withBase(`/posts/${postSeries}/`)} class="series-back-link">
              All {seriesTotal} {currentSeries.name} notes →
            </a>
          </div>
          {tags.length > 0 && (
            <div class="post-meta-row">
              <span class="meta-label">Topics:</span>
              <div class="post-topics">
                {tags.map((slug) => (
                  <a href={topicHref(slug)} class="topic-tag">{topicBySlug(slug)?.label ?? slug}</a>
                ))}
              </div>
            </div>
          )}
          <div class="post-meta-row post-source-row">
            <a href={`${profile.repo}/blob/main/src/content/blog/${postSeries}/${currentSlug}.md`} rel="noopener" target="_blank">
              View Markdown source on GitHub ↗
            </a>
            {source && (
              <a href={source} rel="noopener" target="_blank">
                Associated code ↗
              </a>
            )}
          </div>
        </div>
      </footer>
    </article>
  </main>

  <SiteFooter />

  <script>
    (function () {
      const w = window as any;

      function codeText(pre: Element): string {
        const lines = pre.querySelectorAll('.src');
        if (!lines.length) return (pre.textContent ?? '').trim();
        return Array.prototype.map
          .call(lines, (line: Element) => (line.textContent ?? '').replace(/\n$/, ''))
          .join('\n');
      }

      async function copy(text: string): Promise<boolean> {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch {}

        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(area);
        return ok;
      }

      function init() {
        const blocks = document.querySelectorAll('.codeblock');
        for (let i = 0; i < blocks.length; i++) {
          const label = blocks[i].querySelector('.codeblock-label');
          const pre = blocks[i].querySelector('pre');
          if (!label || !pre) continue;
          if (label.querySelector('.codeblock-copy')) continue;

          const fileName = (label.textContent ?? '').trim();
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'codeblock-copy';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', fileName ? `Copy ${fileName}` : 'Copy code');

          button.addEventListener('click', async function () {
            const done = await copy(codeText(pre));
            button.textContent = done ? 'Copied' : 'Copy failed';
            button.classList.toggle('is-done', done);
            w.setTimeout(function () {
              button.textContent = 'Copy';
              button.classList.remove('is-done');
            }, 1600);
          });

          label.appendChild(button);
        }
      }

      init();
      if (!w.__copyHooked) {
        w.__copyHooked = true;
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>
</BaseLayout>
