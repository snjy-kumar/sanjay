---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { series } from '../data/series';
import { profile } from '../data/site';
import { withBase } from '../utils/base';
import { markFor } from '../data/seriesMarks';
import { topicBySlug } from '../data/tags';
import { topicHref } from '../utils/notes';

interface Props {
  title: string;
  series: string;
  seriesOrder: number;
  date: Date;
  readTime: string;
  description?: string;
  currentSlug: string;
  /** Topic slugs, from the frontmatter. Each one links to its topic page. */
  tags?: string[];
  /** A link to the code this note came from. */
  source?: string;
  /** The notes this one points at. */
  related?: { slug: string; series: string; title: string }[];
  prevPost: { slug: string; title: string; series: string } | null;
  nextPost: { slug: string; title: string; series: string } | null;
}

const {
  title,
  series: postSeries,
  seriesOrder,
  date,
  readTime,
  description,
  currentSlug,
  tags = [],
  source,
  related = [],
  prevPost,
  nextPost,
} = Astro.props;

// Pin to UTC: frontmatter dates parse to UTC midnight, and the build machine's
// local timezone must not shift the displayed day.
const fullDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formattedDateFull = fullDateFormatter.format(date);

// Names come from the timeline list. Counts are the note files that exist,
// so a future title with no file is absent from the rail.
const blogPosts = await getCollection('blog');
const publishedIn = (seriesId: string) =>
  blogPosts.filter((post) => post.data.series === seriesId).length;

// Each series in the rail links to that series' own page, which lists every
// note in it. A series with no published note yet gets no link.
const seriesPageHref = (seriesId: string) => {
  if (!publishedIn(seriesId)) return undefined;
  return withBase(`/posts/${seriesId}/`);
};

const seriesById = Object.fromEntries(series.map((s) => [s.id, s]));
const currentSeries = seriesById[postSeries];

// Every published note, the current series first, so the rail can list them
// all and the filter can search across the series.
const shortDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});

const allPublished = blogPosts
  .map((post) => {
    const [seriesId, slug] = post.id.split('/');
    return {
      series: seriesId,
      seriesName: seriesById[seriesId]?.name ?? seriesId,
      slug,
      title: post.data.title,
      seriesOrder: post.data.seriesOrder,
      dateShort: shortDateFormatter.format(post.data.date),
    };
  })
  .sort((a, b) => {
    if (a.series === postSeries && b.series !== postSeries) return -1;
    if (a.series !== postSeries && b.series === postSeries) return 1;
    return a.seriesOrder - b.seriesOrder;
  });

const inSeries = allPublished.filter((p) => p.series === postSeries);
const positionInSeries = inSeries.findIndex((p) => p.slug === currentSlug) + 1;
const seriesTotal = inSeries.length;

// Absolute URLs for the share card, the series links and the structured
// data. `site` in astro.config.mjs is the same source the sitemap uses.
const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const homeUrl = new URL(withBase('/'), siteOrigin).href;
const ogImageUrl = new URL(withBase(`/og/${postSeries}/${currentSlug}.png`), siteOrigin).href;
const prevUrl = prevPost
  ? new URL(withBase(`/posts/${prevPost.series}/${prevPost.slug}/`), siteOrigin).href
  : undefined;
const nextUrl = nextPost
  ? new URL(withBase(`/posts/${nextPost.series}/${nextPost.slug}/`), siteOrigin).href
  : undefined;
const publishedIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description ? { description } : {}),
  datePublished: publishedIso,
  dateModified: publishedIso,
  inLanguage: 'en',
  articleSection: currentSeries.name,
  image: ogImageUrl,
  author: { '@type': 'Person', name: 'Sanjay Kumar Thakur', url: homeUrl },
  publisher: { '@type': 'Person', name: 'Sanjay Kumar Thakur', url: homeUrl },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, siteOrigin).href,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="post-page"
  ogImage={ogImageUrl}
  ogImageAlt={`${currentSeries.name} note: ${title}`}
  jsonLd={jsonLd}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <div class="shell">
    <div class="work">
      <aside class="rail" aria-label="Reference">
        <a class="brand" href={withBase('/')}>
          <svg class="ico" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="#111" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.25 1.75h7.5V12.25L7 9.5 3.25 12.25z"></path>
          </svg>
          Reference
        </a>

        <p class="nav-label">Series</p>
        <nav aria-label="Series">
          {series.filter((s) => publishedIn(s.id) > 0).map((s) => {
            const count = publishedIn(s.id);
            const href = seriesPageHref(s.id);
            const isCurrent = postSeries === s.id;
            return (
              <a
                class={`series ${isCurrent ? 'is-current' : ''} ${href ? '' : 'is-empty'}`}
                href={href}
                aria-current={isCurrent ? 'true' : undefined}
                aria-disabled={href ? undefined : 'true'}
              >
                <svg class="series-mark" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill={isCurrent ? '#111' : '#444'} d={markFor(s.id)} />
                </svg>
                <span class="series-copy">
                  <span class="series-name">{s.name}</span>
                  <span class="series-count">{count} published</span>
                </span>
              </a>
            );
          })}
        </nav>

        <p class="list-label">Published</p>
        <nav class="note-list" aria-label="Published">
          {inSeries.map(p => {
            const isCurr = p.slug === currentSlug;
            return (
              <a
                class={`note-row ${isCurr ? 'is-current' : ''}`}
                href={withBase(`/posts/${p.series}/${p.slug}/`)}
                aria-current={isCurr ? 'page' : undefined}
              >
                <span class="d">{p.dateShort}</span>
                <span class="t">{p.title}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      <main class="doc">
        <div class="read-bar" aria-hidden="true"><span></span></div>
        <div class="read">
          <p class="series-kicker">
            <a href={withBase(`/posts/${postSeries}/`)}>{currentSeries.name}</a>
          </p>
          <h1 class="note-title">{title}</h1>
          <p class="note-meta">{formattedDateFull} · {readTime} · Published</p>

          <slot />

          <div class="note-end">
            <p class="note-end-meta note-end-head">
              <span>Note {String(positionInSeries).padStart(2, '0')} of {seriesTotal} · {currentSeries.name} series</span>
              <span class="note-end-links">
                {source && (
                  <a class="note-end-source" href={source} rel="noopener">
                    the code this came from
                  </a>
                )}
                <a
                  class="note-end-source"
                  href={`${profile.repo}/blob/main/src/content/blog/${postSeries}/${currentSlug}.md`}
                  rel="noopener"
                >view source</a>
              </span>
            </p>
            {tags.length > 0 && (
              <p class="note-end-meta note-end-topics">
                <span class="note-end-label">Topics</span>
                {tags.map((slug) => (
                  <a href={topicHref(slug)}>{topicBySlug(slug)?.label ?? slug}</a>
                ))}
              </p>
            )}
            {related.length > 0 && (
              <p class="note-end-meta note-end-related">
                <span class="note-end-label">Related</span>
                {related.map((note) => (
                  <a href={withBase(`/posts/${note.series}/${note.slug}/`)}>{note.title}</a>
                ))}
              </p>
            )}
            {!nextPost && (
              <p class="note-end-next">
                <span class="note-end-done">That is the last note published in this series so far.</span>
              </p>
            )}
          </div>
        </div>
      </main>

      <aside class="aside" aria-label="Overview">
        <p class="aside-label">Overview</p>
        <nav aria-label="Overview">
          <ul class="toc">
            <li>
              <a class="is-current" href="#what-it-is" aria-current="true">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="7" cy="7" r="4.75"></circle>
                  <path d="M7 6.35v3.45"></path>
                  <path d="M7 4.4v.02" stroke-width="1.8"></path>
                </svg>
                What it is
              </a>
            </li>
            <li>
              <a href="#the-code">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.9 3.5 2.35 7l2.55 3.5"></path>
                  <path d="M9.1 3.5 11.65 7 9.1 10.5"></path>
                </svg>
                The code
              </a>
            </li>
            <li>
              <a href="#old">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="7" cy="7" r="4.75"></circle>
                  <path d="M7 4.15V7.15l2.15 1.35"></path>
                </svg>
                Old
              </a>
            </li>
            <li>
              <a href="#new">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 2.15 11.7 7 7 11.85 2.3 7z"></path>
                </svg>
                New
              </a>
            </li>
            <li>
              <a href="#when">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.6 2.4v9.2"></path>
                  <path d="M3.6 6.4h4.35"></path>
                  <path d="M7.95 6.4 11.15 3.5"></path>
                  <path d="M7.95 6.4 11.15 9.3"></path>
                </svg>
                When to use which
              </a>
            </li>
            <li>
              <a href="#practice">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.55 2.25 11.75 5.45 5.05 12.15H1.85V8.95z"></path>
                  <path d="M7.35 3.45 10.55 6.65"></path>
                </svg>
                Practice
              </a>
            </li>
            <li>
              <a href="#sources">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5.35 3.15H3.15v7.7h7.7V8.65"></path>
                  <path d="M7.35 6.65 11.55 2.45"></path>
                  <path d="M8.35 2.45h3.2v3.2"></path>
                </svg>
                Sources
              </a>
            </li>
          </ul>
        </nav>
        <div class="meta-block">
          <p>{formattedDateFull}</p>
          <p>{readTime}</p>
        </div>
      </aside>
    </div>

    <nav class="pager" aria-label="Previous and next">
      {prevPost && (
        <a href={withBase(`/posts/${prevPost.series}/${prevPost.slug}/`)}>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M6.5 2L3.5 5l3 3"></path>
          </svg>
          <span class="dir">Previous</span>
          <span class="title">{prevPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a class="pager-next" href={withBase(`/posts/${nextPost.series}/${nextPost.slug}/`)}>
          <span class="dir">Next</span>
          <span class="title">{nextPost.title}</span>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M3.5 5L6.5 2l-3-3"></path>
          </svg>
        </a>
      )}
    </nav>
  </div>

  <script>
    // A copy button on every code block. The code is in the static HTML — the
    // button only reads it and puts it on the clipboard, so the page works
    // exactly the same without JavaScript.
    (function () {
      const w = window as any;

      function codeText(pre: Element): string {
        const lines = pre.querySelectorAll('.src');
        if (!lines.length) return (pre.textContent ?? '').trim();
        return Array.prototype.map
          .call(lines, (line: Element) => (line.textContent ?? '').replace(/\n$/, ''))
          .join('\n');
      }

      async function copy(text: string): Promise<boolean> {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch {
          // Fall through to the textarea approach below.
        }

        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(area);
        return ok;
      }

      function init() {
        const blocks = document.querySelectorAll('.codeblock');
        for (let i = 0; i < blocks.length; i++) {
          const label = blocks[i].querySelector('.codeblock-label');
          const pre = blocks[i].querySelector('pre');
          if (!label || !pre) continue;
          if (label.querySelector('.codeblock-copy')) continue;

          const fileName = (label.textContent ?? '').trim();
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'codeblock-copy';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', fileName ? `Copy ${fileName}` : 'Copy code');

          button.addEventListener('click', async function () {
            const done = await copy(codeText(pre));
            button.textContent = done ? 'Copied' : 'Copy failed';
            button.classList.toggle('is-done', done);
            w.setTimeout(function () {
              button.textContent = 'Copy';
              button.classList.remove('is-done');
            }, 1600);
          });

          label.appendChild(button);
        }
      }

      init();
      if (!w.__copyHooked) {
        w.__copyHooked = true;
        // astro:page-load is dispatched on document and does not bubble,
        // so it has to be listened for there rather than on window.
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>

  <script>
    // Runs once when first loaded; astro:page-load re-runs init() after every
    // client-side navigation (see <ClientRouter /> in BaseLayout) so the TOC
    // scrollspy binds to the freshly-swapped Overview nav. Cleanup + hook
    // guards keep exactly one scrollspy alive across navigations.
    (function () {
      const w = window as any;

      function init() {
        if (typeof w.__spyCleanup === 'function') w.__spyCleanup();
        w.__spyCleanup = null;

        // The published list scrolls on its own; keep the current note visible
        // in it without moving the page.
        const list = document.querySelector('.note-list');
        const currentNote = list?.querySelector('.note-row.is-current');
        if (list && currentNote && list.scrollHeight > list.clientHeight) {
          const listBox = list.getBoundingClientRect();
          const noteBox = currentNote.getBoundingClientRect();
          list.scrollTop +=
            noteBox.top - listBox.top - (list.clientHeight - noteBox.height) / 2;
        }

        const nav = document.querySelector("nav[aria-label='Overview']");
        if (!nav) return;

        const links = Array.prototype.slice.call(
          nav.querySelectorAll("a[href^='#']")
        ) as HTMLAnchorElement[];
        const sections: HTMLElement[] = [];
        for (let i = 0; i < links.length; i++) {
          const href = links[i].getAttribute('href');
          if (!href) continue;
          const section = document.getElementById(href.slice(1));
          if (section) sections.push(section);
        }
        if (!sections.length) return;

        function mark(id: string) {
          for (let i = 0; i < links.length; i++) {
            const link = links[i];
            const on = link.getAttribute('href') === '#' + id;
            link.classList.toggle('is-current', on);
            if (on) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          }
        }

        function activeId() {
          const marker = 128;
          // Trailing sections are often too short to scroll up to the marker
          // band. They wait until their heading reaches the lower part of the
          // screen, so the highlight still moves at the pace of the page
          // instead of jumping as soon as the heading appears.
          const fallbackBand = window.innerHeight * 0.7;
          const scroller = document.scrollingElement || document.documentElement;
          const maxScroll = Math.max(0, scroller.scrollHeight - window.innerHeight);
          const scrolled = window.scrollY;

          let current = sections[0].id;
          for (let i = 0; i < sections.length; i++) {
            const heading = sections[i].querySelector('h2') || sections[i];
            const docTop = heading.getBoundingClientRect().top + scrolled;

            const atMarker = docTop - marker;
            const atBand = docTop - fallbackBand;
            const switchAt = Math.min(atMarker <= maxScroll ? atMarker : atBand, maxScroll);

            if (scrolled >= switchAt) current = sections[i].id;
          }
          return current;
        }

        function sync() {
          mark(activeId());
          readProgress();
        }

        function readProgress() {
          const scroller = document.scrollingElement || document.documentElement;
          const max = scroller.scrollHeight - window.innerHeight;
          const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
          document.documentElement.style.setProperty('--read-progress', String(progress));
        }

        for (let j = 0; j < links.length; j++) {
          links[j].addEventListener('click', function (this: HTMLAnchorElement) {
            const href = this.getAttribute('href');
            if (href) mark(href.slice(1));
          });
        }

        window.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        window.addEventListener('hashchange', sync);
        sync();

        w.__spyCleanup = function () {
          window.removeEventListener('scroll', sync);
          window.removeEventListener('resize', sync);
          window.removeEventListener('hashchange', sync);
        };
      }

      init();
      if (!w.__spyHooked) {
        w.__spyHooked = true;
        // astro:page-load is dispatched on document and does not bubble,
        // so it has to be listened for there rather than on window.
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>


</BaseLayout>
