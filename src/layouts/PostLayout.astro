---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { series } from '../data/series';
import { profile } from '../data/site';
import { withBase } from '../utils/base';
import { markFor } from '../data/seriesMarks';
import { topicBySlug } from '../data/tags';
import { topicHref } from '../utils/notes';

interface Props {
  title: string;
  series: string;
  seriesOrder: number;
  date: Date;
  readTime: string;
  description?: string;
  currentSlug: string;
  tags?: string[];
  source?: string;
  related?: { slug: string; series: string; title: string }[];
  prevPost: { slug: string; title: string; series: string } | null;
  nextPost: { slug: string; title: string; series: string } | null;
}

const {
  title,
  series: postSeries,
  seriesOrder,
  date,
  readTime,
  description,
  currentSlug,
  tags = [],
  source,
  related = [],
  prevPost,
  nextPost,
} = Astro.props;

const fullDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formattedDateFull = fullDateFormatter.format(date);

const blogPosts = await getCollection('blog');
const publishedIn = (seriesId: string) =>
  blogPosts.filter((post) => post.data.series === seriesId).length;

const seriesPageHref = (seriesId: string) => {
  if (!publishedIn(seriesId)) return undefined;
  return withBase(`/posts/${seriesId}/`);
};

const seriesById = Object.fromEntries(series.map((s) => [s.id, s]));
const currentSeries = seriesById[postSeries] ?? {
  id: postSeries,
  name: postSeries.charAt(0).toUpperCase() + postSeries.slice(1),
  description: '',
  posts: [],
};

const shortDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});

const inSeries = blogPosts
  .filter((p) => p.data.series === postSeries)
  .map((p) => {
    const [, slug] = p.id.split('/');
    return {
      slug,
      title: p.data.title,
      seriesOrder: p.data.seriesOrder,
      dateShort: shortDateFormatter.format(p.data.date),
    };
  })
  .sort((a, b) => a.seriesOrder - b.seriesOrder);

const positionInSeries = inSeries.findIndex((p) => p.slug === currentSlug) + 1 || seriesOrder;
const seriesTotal = inSeries.length;

// Display main active and scheduled series in the left rail
const displaySeries = series.filter(
  (s) => publishedIn(s.id) > 0 || ['javascript', 'redux'].includes(s.id),
);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const homeUrl = new URL(withBase('/'), siteOrigin).href;
const ogImageUrl = new URL(withBase(`/og/${postSeries}/${currentSlug}.png`), siteOrigin).href;
const prevUrl = prevPost
  ? new URL(withBase(`/posts/${prevPost.series}/${prevPost.slug}/`), siteOrigin).href
  : undefined;
const nextUrl = nextPost
  ? new URL(withBase(`/posts/${nextPost.series}/${nextPost.slug}/`), siteOrigin).href
  : undefined;
const publishedIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      ...(description ? { description } : {}),
      datePublished: publishedIso,
      dateModified: publishedIso,
      inLanguage: 'en',
      articleSection: currentSeries.name,
      image: ogImageUrl,
      author: { '@type': 'Person', name: profile.name, url: homeUrl },
      publisher: { '@type': 'Person', name: profile.name, url: homeUrl },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': new URL(Astro.url.pathname, siteOrigin).href,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Notes',
          item: new URL(withBase('/posts/'), siteOrigin).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: currentSeries.name,
          item: new URL(withBase(`/posts/${postSeries}/`), siteOrigin).href,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: title,
          item: new URL(Astro.url.pathname, siteOrigin).href,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="post-page"
  ogImage={ogImageUrl}
  ogImageAlt={`${currentSeries.name} note: ${title}`}
  jsonLd={jsonLd}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <a class="skip" href="#main">Skip to content</a>

  <div class="shell">
    <div class="work">
      <!-- Left Rail: Series Navigation & Notes List -->
      <aside class="rail" aria-label="Reference">
        <div class="rail-top">
          <a class="brand" href={withBase('/')}>
            <svg class="ico" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="#111" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.25 1.75h7.5V12.25L7 9.5 3.25 12.25z"></path>
            </svg>
            Reference
          </a>
          <button type="button" class="rail-search-btn" data-open-search aria-label="Search all notes (Cmd+K)">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="7" cy="7" r="4.5"></circle>
              <path d="M10.5 10.5L14 14"></path>
            </svg>
            <span>⌘K</span>
          </button>
        </div>

        <p class="nav-label">Series</p>
        <nav aria-label="Series">
          {displaySeries.map((s) => {
            const count = publishedIn(s.id);
            const href = seriesPageHref(s.id);
            const isCurrent = postSeries === s.id;
            return (
              <a
                class={`series ${isCurrent ? 'is-current' : ''} ${href ? '' : 'is-empty'}`}
                href={href}
                aria-current={isCurrent ? 'true' : undefined}
                aria-disabled={href ? undefined : 'true'}
              >
                <svg class="series-mark" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill={isCurrent ? '#111' : '#444'} d={markFor(s.id)} />
                </svg>
                <span class="series-copy">
                  <span class="series-name">{s.name}</span>
                  <span class="series-count">
                    {count > 0 ? `${count} published` : `${s.posts.length} planned`}
                  </span>
                </span>
              </a>
            );
          })}
        </nav>

        <p class="list-label">{currentSeries.name} notes</p>
        <div class="rail-filter-wrap">
          <input
            type="search"
            class="rail-filter-input"
            id="rail-filter"
            placeholder={`Filter ${currentSeries.name}...`}
            aria-label={`Filter ${currentSeries.name} notes`}
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <nav class="note-list" aria-label="Published in series">
          {inSeries.map((p) => {
            const isCurr = p.slug === currentSlug;
            return (
              <a
                class={`note-row ${isCurr ? 'is-current' : ''}`}
                href={withBase(`/posts/${postSeries}/${p.slug}/`)}
                aria-current={isCurr ? 'page' : undefined}
              >
                <span class="d">{p.dateShort}</span>
                <span class="t">{p.title}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      <!-- Center: Note Article Content -->
      <main class="doc" id="main">
        <div class="read-bar" aria-hidden="true"><span></span></div>
        <div class="read">
          <p class="series-kicker">
            <a href={withBase(`/posts/${postSeries}/`)}>{currentSeries.name}</a>
          </p>
          <h1 class="note-title">{title}</h1>
          <p class="note-meta">{formattedDateFull} · {readTime} · Published</p>

          <slot />

          <div class="note-end">
            <p class="note-end-meta note-end-head">
              <span>Note {String(positionInSeries).padStart(2, '0')} of {seriesTotal} · {currentSeries.name} series</span>
              <span class="note-end-links">
                {source && (
                  <a class="note-end-source" href={source} rel="noopener">
                    the code this came from
                  </a>
                )}
                <a
                  class="note-end-source"
                  href={`${profile.repo}/blob/main/src/content/blog/${postSeries}/${currentSlug}.md`}
                  rel="noopener"
                  target="_blank"
                >view source</a>
              </span>
            </p>
            {tags.length > 0 && (
              <p class="note-end-meta note-end-topics">
                <span class="note-end-label">Topics</span>
                {tags.map((slug) => (
                  <a href={topicHref(slug)}>{topicBySlug(slug)?.label ?? slug}</a>
                ))}
              </p>
            )}
            {related.length > 0 && (
              <p class="note-end-meta note-end-related">
                <span class="note-end-label">Related</span>
                {related.map((note) => (
                  <a href={withBase(`/posts/${note.series}/${note.slug}/`)}>{note.title}</a>
                ))}
              </p>
            )}
            {!nextPost && (
              <p class="note-end-next">
                <span class="note-end-done">That is the last note published in this series so far.</span>
              </p>
            )}
          </div>
        </div>
      </main>

      <!-- Right Rail: Section Overview Outline -->
      <aside class="aside" aria-label="Overview outline">
        <p class="aside-label">Overview</p>
        <nav aria-label="Section outline">
          <ul class="toc">
            <li>
              <a class="is-current" href="#what-it-is" aria-current="true">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="7" cy="7" r="4.75"></circle>
                  <path d="M7 6.35v3.45"></path>
                  <path d="M7 4.4v.02" stroke-width="1.8"></path>
                </svg>
                What it is
              </a>
            </li>
            <li>
              <a href="#the-code">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.9 3.5 2.35 7l2.55 3.5"></path>
                  <path d="M9.1 3.5 11.65 7 9.1 10.5"></path>
                </svg>
                The code
              </a>
            </li>
            <li>
              <a href="#old">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="7" cy="7" r="4.75"></circle>
                  <path d="M7 4.15V7.15l2.15 1.35"></path>
                </svg>
                Old
              </a>
            </li>
            <li>
              <a href="#new">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 2.15 11.7 7 7 11.85 2.3 7z"></path>
                </svg>
                New
              </a>
            </li>
            <li>
              <a href="#when">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.6 2.4v9.2"></path>
                  <path d="M3.6 6.4h4.35"></path>
                  <path d="M7.95 6.4 11.15 3.5"></path>
                  <path d="M7.95 6.4 11.15 9.3"></path>
                </svg>
                When to use which
              </a>
            </li>
            <li>
              <a href="#practice">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.55 2.25 11.75 5.45 5.05 12.15H1.85V8.95z"></path>
                  <path d="M7.35 3.45 10.55 6.65"></path>
                </svg>
                Practice
              </a>
            </li>
            <li>
              <a href="#sources">
                <svg class="ico" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5.35 3.15H3.15v7.7h7.7V8.65"></path>
                  <path d="M7.35 6.65 11.55 2.45"></path>
                  <path d="M8.35 2.45h3.2v3.2"></path>
                </svg>
                Sources
              </a>
            </li>
          </ul>
        </nav>
        <div class="meta-block">
          <p>{formattedDateFull}</p>
          <p>{readTime}</p>
        </div>
      </aside>
    </div>

    <!-- Pager: Previous & Next -->
    <nav class="pager" aria-label="Previous and next">
      {prevPost && (
        <a class="pager-prev" href={withBase(`/posts/${prevPost.series}/${prevPost.slug}/`)}>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M6.5 2L3.5 5l3 3"></path>
          </svg>
          <span class="dir">Previous <kbd class="kbd-hint">k</kbd></span>
          <span class="title">{prevPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a class="pager-next" href={withBase(`/posts/${nextPost.series}/${nextPost.slug}/`)}>
          <span class="dir">Next <kbd class="kbd-hint">j</kbd></span>
          <span class="title">{nextPost.title}</span>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M3.5 5L6.5 2l-3-3"></path>
          </svg>
        </a>
      )}
    </nav>
  </div>

  <!-- Copy button script -->
  <script>
    (function () {
      const w = window as any;

      function codeText(pre: Element): string {
        const lines = pre.querySelectorAll('.src');
        if (!lines.length) return (pre.textContent ?? '').trim();
        return Array.prototype.map
          .call(lines, (line: Element) => (line.textContent ?? '').replace(/\n$/, ''))
          .join('\n');
      }

      async function copy(text: string): Promise<boolean> {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch {}

        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(area);
        return ok;
      }

      function init() {
        const blocks = document.querySelectorAll('.codeblock');
        for (let i = 0; i < blocks.length; i++) {
          const label = blocks[i].querySelector('.codeblock-label');
          const pre = blocks[i].querySelector('pre');
          if (!label || !pre) continue;
          if (label.querySelector('.codeblock-copy')) continue;

          const fileName = (label.textContent ?? '').trim();
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'codeblock-copy';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', fileName ? `Copy ${fileName}` : 'Copy code');

          button.addEventListener('click', async function () {
            const done = await copy(codeText(pre));
            button.textContent = done ? 'Copied' : 'Copy failed';
            button.classList.toggle('is-done', done);
            w.setTimeout(function () {
              button.textContent = 'Copy';
              button.classList.remove('is-done');
            }, 1600);
          });

          label.appendChild(button);
        }
      }

      init();
      if (!w.__copyHooked) {
        w.__copyHooked = true;
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>

  <!-- Scrollspy script for right outline TOC, rail note filter, and keyboard navigation -->
  <script>
    (function () {
      const w = window as any;

      function init() {
        if (typeof w.__spyCleanup === 'function') w.__spyCleanup();
        w.__spyCleanup = null;

        // Auto-scroll note list to current note
        const list = document.querySelector('.note-list');
        const currentNote = list?.querySelector('.note-row.is-current');
        if (list && currentNote && list.scrollHeight > list.clientHeight) {
          const listBox = list.getBoundingClientRect();
          const noteBox = currentNote.getBoundingClientRect();
          list.scrollTop +=
            noteBox.top - listBox.top - (list.clientHeight - noteBox.height) / 2;
        }

        // Rail note filtering
        const filterInput = document.getElementById('rail-filter') as HTMLInputElement | null;
        const noteRows = Array.from(document.querySelectorAll('.note-list .note-row')) as HTMLElement[];
        if (filterInput && noteRows.length > 0) {
          filterInput.value = '';
          filterInput.oninput = () => {
            const q = filterInput.value.trim().toLowerCase();
            for (const row of noteRows) {
              const text = (row.textContent || '').toLowerCase();
              row.style.display = text.includes(q) ? '' : 'none';
            }
          };
          filterInput.onkeydown = (e) => {
            if (e.key === 'Escape') {
              filterInput.value = '';
              for (const row of noteRows) row.style.display = '';
              filterInput.blur();
            }
          };
        }

        // Outline scrollspy
        const sections = Array.from(document.querySelectorAll('section[id]'));
        const links = Array.from(document.querySelectorAll('.toc a'));

        const linkByHash = new Map(
          links.map((link) => [link.getAttribute('href') ?? '', link]),
        );

        let activeId: string | null = null;

        function update() {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          let current: string | null = null;

          for (let i = sections.length - 1; i >= 0; i--) {
            const section = sections[i] as HTMLElement;
            if (section.offsetTop - 120 <= scrollY) {
              current = section.id;
              break;
            }
          }

          if (current !== activeId) {
            activeId = current;
            links.forEach((l) => l.classList.remove('is-current'));
            if (current) {
              const active = linkByHash.get(`#${current}`);
              if (active) active.classList.add('is-current');
            }
          }
        }

        window.addEventListener('scroll', update, { passive: true });
        update();

        // Keyboard navigation: j/k or ArrowLeft/ArrowRight to walk series notes
        function handleKey(e: KeyboardEvent) {
          if (
            e.target instanceof HTMLInputElement ||
            e.target instanceof HTMLTextAreaElement ||
            (e.target as HTMLElement)?.isContentEditable
          ) {
            return;
          }
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key === 'j' || e.key === 'ArrowRight') {
            const next = document.querySelector('.pager-next') as HTMLAnchorElement | null;
            if (next) next.click();
          } else if (e.key === 'k' || e.key === 'ArrowLeft') {
            const prev = document.querySelector('.pager-prev') as HTMLAnchorElement | null;
            if (prev) prev.click();
          }
        }
        window.addEventListener('keydown', handleKey);

        w.__spyCleanup = () => {
          window.removeEventListener('scroll', update);
          window.removeEventListener('keydown', handleKey);
        };
      }

      init();
      if (!w.__spyHooked) {
        w.__spyHooked = true;
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>
</BaseLayout>
