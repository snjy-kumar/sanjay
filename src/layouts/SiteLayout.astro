---
// The shell every site-level page uses — the homepage, the series pages,
// the topic pages, the path and the log.
//
// It is the same light "paper" look as the homepage, with one column of
// readable width. Note pages have their own shell (PostLayout) because they
// are a different kind of page: three columns, a rail, and an outline.
import BaseLayout from './BaseLayout.astro';
import { profile, profileLinks } from '../data/site';
import { withBase } from '../utils/base';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage, ogImageAlt, jsonLd } = Astro.props;

// The pages a reader can reach from the footer of any site-level page.
const siteNav = [
  { label: 'Learning path', href: withBase('/path/') },
  { label: 'Topics', href: withBase('/topics/') },
  { label: 'Log', href: withBase('/log/') },
  { label: 'Feed', href: withBase('/rss.xml') },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  jsonLd={jsonLd}
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <p class="name"><a href={withBase('/')}>{profile.name}</a></p>
    <p class="where">{profile.location} <span id="clock"></span></p>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer>
    {profile.buttondown && (
      <form
        class="subscribe"
        action={`https://buttondown.email/api/emails/embed-subscribe/${profile.buttondown}`}
        method="post"
        target="popupwindow"
      >
        <label for="subscribe-email">Each new note, by email</label>
        <input
          id="subscribe-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button type="submit">Subscribe</button>
        <p class="subscribe-note">
          No tracking, no newsletter. Unsubscribe in one click.
        </p>
      </form>
    )}
    <nav aria-label="Elsewhere">
      {profileLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <nav aria-label="This site">
      {siteNav.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <p>Notes on React, TypeScript and JavaScript, one a day. Built with Astro.</p>
  </footer>

  <script>
    // The clock in the header. It runs once on first load; astro:page-load
    // re-runs start() after every client-side navigation (see <ClientRouter />
    // in BaseLayout) so the clock finds the freshly-swapped #clock element.
    // Guards keep a single interval alive.
    (function () {
      const w = window as any;

      function tick() {
        const clock = document.getElementById('clock');
        if (!clock) return;
        const time = new Intl.DateTimeFormat('en-IN', {
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
          timeZone: 'Asia/Kolkata',
        }).format(new Date());
        clock.textContent = '· ' + time;
      }

      function start() {
        tick();
        if (!w.__clockInterval) {
          w.__clockInterval = setInterval(tick, 30000);
        }
      }

      start();
      if (!w.__clockHooked) {
        w.__clockHooked = true;
        document.addEventListener('astro:page-load', start);
      }
    })();
  </script>
</BaseLayout>
