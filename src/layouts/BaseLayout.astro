---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/base';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = 'Sanjay Kumar Thakur, software engineer in Pune. React, TypeScript, and Node.',
  bodyClass,
  ogImage,
  ogImageAlt,
  jsonLd,
  prevUrl,
  nextUrl,
} = Astro.props;

// Absolute URL for canonical + Open Graph, built from `site` in
// astro.config.mjs (same source of truth as the sitemap).
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogType = Astro.url.pathname.startsWith('/posts/') ? 'article' : 'website';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title="Sanjay Kumar Thakur" href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <!-- The previous and next note in the series, so a crawler can walk the
         series in order instead of guessing it from the page structure. -->
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <!-- Open Graph / Twitter (social shares feed back into discovery/SEO) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sanjay Kumar Thakur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt ?? title} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Structured data for the note: what it is, when it was published and
         who wrote it, in a form search engines can read. -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Client-side routing: links navigate without a full page refresh -->
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
  <script>
    // A copy button on every code block. The code is in the static HTML — the
    // button only reads it and puts it on the clipboard, so the page works
    // exactly the same without JavaScript.
    (function () {
      const w = window as any;

      function codeText(pre: Element): string {
        const lines = pre.querySelectorAll('.src');
        if (!lines.length) return (pre.textContent ?? '').trim();
        return Array.prototype.map
          .call(lines, (line: Element) => (line.textContent ?? '').replace(/\n$/, ''))
          .join('\n');
      }

      async function copy(text: string): Promise<boolean> {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch {
          // Fall through to the textarea approach below.
        }

        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(area);
        return ok;
      }

      function init() {
        const blocks = document.querySelectorAll('.codeblock');
        for (let i = 0; i < blocks.length; i++) {
          const label = blocks[i].querySelector('.codeblock-label');
          const pre = blocks[i].querySelector('pre');
          if (!label || !pre) continue;
          if (label.querySelector('.codeblock-copy')) continue;

          const fileName = (label.textContent ?? '').trim();
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'codeblock-copy';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', fileName ? `Copy ${fileName}` : 'Copy code');

          button.addEventListener('click', async function () {
            const done = await copy(codeText(pre));
            button.textContent = done ? 'Copied' : 'Copy failed';
            button.classList.toggle('is-done', done);
            w.setTimeout(function () {
              button.textContent = 'Copy';
              button.classList.remove('is-done');
            }, 1600);
          });

          label.appendChild(button);
        }
      }

      init();
      if (!w.__copyHooked) {
        w.__copyHooked = true;
        // astro:page-load is dispatched on document and does not bubble,
        // so it has to be listened for there rather than on window.
        document.addEventListener('astro:page-load', init);
      }
    })();
  </script>
  </body>
</html>
