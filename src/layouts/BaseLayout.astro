---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/base';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = 'Sanjay Kumar Thakur, software engineer in Pune. React, TypeScript, and Node.',
  bodyClass,
  ogImage,
  ogImageAlt,
  jsonLd,
  prevUrl,
  nextUrl,
} = Astro.props;

// Absolute URL for canonical + Open Graph, built from `site` in
// astro.config.mjs (same source of truth as the sitemap).
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogType = Astro.url.pathname.startsWith('/posts/') ? 'article' : 'website';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
    <!-- The two faces the first paint needs, so the text does not swap
         after the page has already started to render. -->
    <link rel="preload" href={withBase('/fonts/ibm-plex-sans-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/ibm-plex-sans-600.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title="Sanjay Kumar Thakur" href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <!-- The previous and next note in the series, so a crawler can walk the
         series in order instead of guessing it from the page structure. -->
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <!-- Open Graph / Twitter (social shares feed back into discovery/SEO) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sanjay Kumar Thakur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt ?? title} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Structured data for the note: what it is, when it was published and
         who wrote it, in a form search engines can read. -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Client-side routing: links navigate without a full page refresh -->
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
