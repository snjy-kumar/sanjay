---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/base';
import { longDate } from '../utils/notes';

const entries = (await getCollection('log')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// The body of each entry, rendered at build time — the log is static HTML,
// like every other page here.
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase('/og/log.png'), siteOrigin).href;

const description = `The unedited session log behind the notes: ${entries.length} entries, what I was learning on each day, and what went wrong.`;
---

<SiteLayout
  title="The log — the unedited sessions behind the notes"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="The learning log"
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Log</span></p>
  <h1>The log</h1>
  <p class="lead">
    The notes are the edited version. This is the raw log: what I was
    learning each day, what I got wrong, and how long it took. Nothing here
    is polished, which is the point.
  </p>
  <p class="span">{entries.length} entries</p>

  <div class="log-list">
    {rendered.map(({ entry, Content }) => (
      <article class="log-entry">
        <header>
          <h2>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>
              {longDate(entry.data.date)}
            </time>
          </h2>
          <p class="log-session">{entry.data.session}</p>
          {entry.data.focus && <p class="log-focus">{entry.data.focus}</p>}
        </header>
        <div class="log-body">
          <Content />
        </div>
      </article>
    ))}
  </div>
</SiteLayout>
