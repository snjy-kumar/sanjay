---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { series } from '../../../data/series';
import { plansForSeries } from '../../../data/plans';
import { topicBySlug } from '../../../data/tags';
import { withBase } from '../../../utils/base';
import { noteHref, notesInSeries, shortDate, topicHref, undatedLabel, usedTopics } from '../../../utils/notes';

// One page per series that has at least one published note. A series with
// no notes yet has nothing to say, so it does not get a page — and nothing
// links to one.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return series
    .filter((s) => posts.some((post) => post.data.series === s.id))
    .map((s) => ({ params: { series: s.id } }));
}

const seriesId = Astro.params.series!;
const current = series.find((s) => s.id === seriesId)!;

const posts = await getCollection('blog');
const notes = notesInSeries(posts, seriesId);

// An undated series lists every note it plans, in order: the written ones
// linked, the rest marked "not written yet". A dated series lists only what
// is published, as before.
const undatedRows = current.undated
  ? (current.planned ?? []).map((row, index) => ({
      number: String(index + 1).padStart(2, '0'),
      title: row.title,
      note: notes.find((note) => note.data.seriesOrder === index + 1),
    }))
  : [];
const plannedTotal = current.planned?.length ?? 0;

// Only the series that actually have a page can be linked to.
const withPages = series.filter((s) => posts.some((post) => post.data.series === s.id));
const here = withPages.findIndex((s) => s.id === seriesId);
const previous = here > 0 ? withPages[here - 1] : null;
const next = here < withPages.length - 1 ? withPages[here + 1] : null;

// The topics this series actually covers, not the ones it planned to cover.
// A planned series has no curated list yet, so it falls back to the topics its
// first notes use; the list can be curated later without changing the page.
const topicSlugs = current.topics.length > 0
  ? current.topics.filter((slug) => notes.some((note) => note.data.tags.includes(slug)))
  : usedTopics(notes);

// The plans that send notes to this series, and which of their phases do.
const planEntries = await getCollection('plans');
const seriesPlans = plansForSeries(seriesId).map((plan) => ({
  plan,
  title: planEntries.find((entry) => entry.id === plan.id)?.data.title ?? plan.label,
  phases: plan.phases.filter((phase) => phase.series.includes(seriesId)),
}));

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase(`/og/${seriesId}/index.png`), siteOrigin).href;
const pageUrl = new URL(withBase(`/posts/${seriesId}/`), siteOrigin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${current.name} notes`,
  description: current.description,
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Sanjay Kumar Thakur',
    url: new URL(withBase('/'), siteOrigin).href,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: notes.length,
    itemListElement: notes.map((note, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(noteHref(note), siteOrigin).href,
      name: note.data.title,
    })),
  },
};
---

<SiteLayout
  title={`${current.name} notes — ${notes.length} notes on ${current.name.toLowerCase()}`}
  description={current.description}
  ogImage={ogImageUrl}
  ogImageAlt={`${current.name} — ${notes.length} notes`}
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>{current.name}</span></p>
  <h1>{current.name}</h1>
  <p class="lead">{current.blurb}</p>
  <p class="span">
    {current.undated
      ? <>{notes.length} of {plannedTotal} notes written · undated, each one live when it is written</>
      : <>{notes.length} {notes.length === 1 ? 'note' : 'notes'} · {current.dateRange}</>}
  </p>

  <h2>In this series</h2>
  {current.undated ? (
  <ol class="journey">
    {undatedRows.map(({ number, title, note }) => note ? (
      <li class="past">
        <p class="when">
          {number}
          <span class="state">{note.data.readTime}</span>
        </p>
        <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
        <p class="desc">{note.data.description}</p>
      </li>
    ) : (
      <li class="ahead">
        <p class="when">{number} · not written yet</p>
        <p class="post">{title}</p>
      </li>
    ))}
  </ol>
  ) : (
  <ul class="journey">
    {notes.map((note) => (
      <li class="past">
        <p class="when">
          {note.data.date ? (
            <time datetime={note.data.date.toISOString().slice(0, 10)}>
              {shortDate(note.data.date)}
            </time>
          ) : undatedLabel(note)}
          <span class="state">{note.data.readTime}</span>
        </p>
        <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
        <p class="desc">{note.data.description}</p>
      </li>
    ))}
  </ul>
  )}

  {topicSlugs.length > 0 && (
    <>
      <h2>Topics in this series</h2>
      <ul class="topic-list">
        {topicSlugs.map((slug) => (
          <li>
            <a href={topicHref(slug)}>{topicBySlug(slug)?.label ?? slug}</a>
          </li>
        ))}
      </ul>
    </>
  )}

  {seriesPlans.length > 0 && (
    <>
      <h2>The plans behind this series</h2>
      <p class="series-note">
        The roadmaps this series is a deep dive for, and the phases of each
        that it covers. The <a href={withBase('/path/#strategy')}>learning path</a>{' '}
        compares them side by side.
      </p>
      <ul class="roadmap-list">
        {seriesPlans.map(({ plan, title, phases }) => (
          <li>
            <h3><a href={withBase(`/plans/${plan.id}/`)}>{title}</a></h3>
            <p class="meta">{plan.length}</p>
            <p>
              {phases.map((phase) => `${plan.unit === 'Steps' ? 'Steps' : plan.unit === 'Week' ? 'Week' : plan.unit === 'Months' ? 'Book' : 'Phase'} ${plan.unit === 'Steps' ? phase.when : phase.n}: ${phase.focus}`).join(' · ')}
            </p>
          </li>
        ))}
      </ul>
    </>
  )}

  <nav class="series-pager" aria-label="Other series">
    {previous ? (
      <a href={withBase(`/posts/${previous.id}/`)}>
        <span class="dir">Previous series</span>
        <span class="title">{previous.name}</span>
      </a>
    ) : (
      <span></span>
    )}
    {next && (
      <a class="pager-next" href={withBase(`/posts/${next.id}/`)}>
        <span class="dir">Next series</span>
        <span class="title">{next.name}</span>
      </a>
    )}
  </nav>
</SiteLayout>
