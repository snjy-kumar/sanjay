---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Format short date as "27 Sep" — manual formatting with UTC getters so the
  // output is stable regardless of build-machine locale or timezone (Intl
  // gives "27 Sept" for en-GB and "Sep 27" for en-US).
  const SHORT_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const shortDateFormatter = (d: Date) =>
    `${d.getUTCDate()} ${SHORT_MONTHS[d.getUTCMonth()]}`;

  return posts.map((post) => {
    // post.id is e.g. "typescript/01"
    const [seriesName, postSlug] = post.id.split('/');

    const seriesPosts = posts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);

    const currentIndex = seriesPosts.findIndex((p) => p.id === post.id);
    const prevEntry = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
    const nextEntry = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;

    const prevPost = prevEntry
      ? {
          slug: prevEntry.id.split('/')[1],
          title: prevEntry.data.title,
          series: prevEntry.data.series,
        }
      : null;

    const nextPost = nextEntry
      ? {
          slug: nextEntry.id.split('/')[1],
          title: nextEntry.data.title,
          series: nextEntry.data.series,
        }
      : null;

    const allPosts = seriesPosts.map((p) => {
      const parts = p.id.split('/');
      return {
        id: p.id,
        slug: parts[1],
        title: p.data.title,
        series: p.data.series,
        seriesOrder: p.data.seriesOrder,
        date: p.data.date,
        dateShort: shortDateFormatter(p.data.date),
      };
    });

    return {
      params: {
        series: seriesName,
        slug: postSlug,
      },
      props: {
        post,
        currentSlug: postSlug,
        allPosts,
        prevPost,
        nextPost,
      },
    };
  });
}

const { post, currentSlug, allPosts, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  series={post.data.series}
  seriesOrder={post.data.seriesOrder}
  date={post.data.date}
  readTime={post.data.readTime}
  description={post.data.description}
  currentSlug={currentSlug}
  allPosts={allPosts}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
