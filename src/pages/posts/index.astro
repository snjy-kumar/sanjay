---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { series } from '../../data/series';
import { withBase } from '../../utils/base';
import { markFor } from '../../data/seriesMarks';
import { shortDate, noteHref, seriesName } from '../../utils/notes';

const blogPosts = await getCollection('blog');
const allPublishedNotes = [...blogPosts].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const activeSeries = series.filter((s) =>
  blogPosts.some((post) => post.data.series === s.id),
);

const upcomingSeries = series.filter(
  (s) => !blogPosts.some((post) => post.data.series === s.id) && s.posts.length > 0,
);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase('/og/home.png'), siteOrigin).href;
const pageUrl = new URL(withBase('/posts/'), siteOrigin).href;

const description = `All engineering notes by Sanjay Kumar Thakur. ${blogPosts.length} published notes across ${activeSeries.length} active series.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Engineering Notes',
  description,
  url: pageUrl,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allPublishedNotes.length,
    itemListElement: allPublishedNotes.map((note, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(noteHref(note), siteOrigin).href,
      name: note.data.title,
    })),
  },
};
---

<SiteLayout
  title="Notes & Series — Sanjay Kumar Thakur"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="Engineering Notes"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Notes</span></p>
  <h1>Engineering notes</h1>
  <p class="lead">
    Practical wrong-vs-right notes on TypeScript, React, JavaScript and software systems.
    Written as I encounter real production bugs and architectural lessons.
  </p>

  <section class="section-group">
    <h2>Active series</h2>
    <div class="series-card-grid">
      {activeSeries.map((s) => {
        const publishedCount = blogPosts.filter((p) => p.data.series === s.id).length;
        return (
          <article class="series-overview-card">
            <header class="series-card-head">
              <svg class="series-mark" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={markFor(s.id)} />
              </svg>
              <div>
                <h3><a href={withBase(`/posts/${s.id}/`)}>{s.name}</a></h3>
                <p class="meta">{publishedCount} of {s.posts.length} published · {s.dateRange}</p>
              </div>
            </header>
            <p class="series-desc">{s.description}</p>
            <p class="series-card-action">
              <a href={withBase(`/posts/${s.id}/`)}>Browse {s.name} notes ({publishedCount}) →</a>
            </p>
          </article>
        );
      })}
    </div>
  </section>

  {upcomingSeries.length > 0 && (
    <section class="section-group">
      <h2>Upcoming scheduled series</h2>
      <div class="upcoming-series-list">
        {upcomingSeries.map((s) => (
          <div class="upcoming-series-item">
            <div class="upcoming-main">
              <strong>{s.name}</strong>
              <span class="upcoming-meta">{s.posts.length} notes scheduled · {s.dateRange}</span>
            </div>
            <p class="desc">{s.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section-group">
    <h2>All published notes ({allPublishedNotes.length})</h2>
    <ul class="journey">
      {allPublishedNotes.map((note) => (
        <li class="past">
          <p class="when">
            <time datetime={note.data.date.toISOString().slice(0, 10)}>
              {shortDate(note.data.date)}
            </time>
            <span class="state">{seriesName(note.data.series)}</span>
          </p>
          <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
