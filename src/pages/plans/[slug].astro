---
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { series } from '../../data/series';
import { withBase } from '../../utils/base';
import { publishedIn } from '../../utils/notes';

export async function getStaticPaths() {
  const plans = await getCollection('plans');
  return plans.map((plan) => ({ params: { slug: plan.id } }));
}

const plan = await getEntry('plans', Astro.params.slug!);
const { Content, headings } = await render(plan);

const posts = await getCollection('blog');

const related = plan.data.series
  ? series.find((s) => s.id === plan.data.series)
  : undefined;

const relatedHasPage = related ? publishedIn(posts, related.id) > 0 : false;
const outlineHeadings = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const pageUrl = new URL(withBase(`/plans/${plan.id}/`), siteOrigin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: plan.data.title,
  description: plan.data.description,
  url: pageUrl,
  inLanguage: 'en',
  ...(plan.data.date ? { datePublished: plan.data.date.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: 'Sanjay Kumar Thakur',
    url: new URL(withBase('/'), siteOrigin).href,
  },
};
---

<SiteLayout
  title={plan.data.title}
  description={plan.data.description}
  ogImage={new URL(withBase('/og/path.png'), siteOrigin).href}
  ogImageAlt={plan.data.title}
  jsonLd={jsonLd}
>
  <p class="crumb">
    <a href={withBase('/')}>Home</a> /
    <a href={withBase('/path/')}>Curriculum</a> /
    <span>{plan.data.title}</span>
  </p>
  <h1>{plan.data.title}</h1>
  <p class="lead">{plan.data.description}</p>
  {related && (
    <p class="span">
      The plan behind the {related.name} series · {related.dateRange}
    </p>
  )}

  <div class="plan-layout">
    <div class="entry plan plan-main">
      <Content />
    </div>
    {outlineHeadings.length > 0 && (
      <aside class="plan-aside" aria-label="Roadmap outline">
        <p class="aside-label">Outline</p>
        <nav aria-label="Roadmap sections">
          <ul class="plan-toc">
            {outlineHeadings.map((h) => (
              <li class={`plan-toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</SiteLayout>
