---
// Every plan on one page, grouped by what kind of plan it is.
//
// The plans are the map; the series are the deep dives. This page is the
// way into the map: the three roadmaps, the fundamentals under all three,
// the books, and the plan behind each series.
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { series } from '../../data/series';
import { checkPlans, planById, planGroups, plansInGroup } from '../../data/plans';
import { withBase } from '../../utils/base';
import { publishedIn, seriesName } from '../../utils/notes';

const entries = await getCollection('plans');
const posts = await getCollection('blog');

// The data in plans.ts, series.ts and roadmap.ts has to agree with itself
// and with the files in src/content/plans/, or the build stops here.
checkPlans(entries.map((entry) => entry.id));

const entryOf = (id: string) => entries.find((entry) => entry.id === id)!;

const groups = planGroups
  .map((group) => ({ group, plans: plansInGroup(group.id) }))
  .filter(({ plans }) => plans.length > 0);

const allPlans = groups.flatMap(({ plans }) => plans);
const phaseCount = allPlans.reduce((sum, plan) => sum + plan.phases.length, 0);
const plannedCount = series.reduce((sum, s) => sum + (s.planned?.length ?? 0), 0);
const slotCount = series.filter((s) => s.posts.length === 0).length;
const coveringNotes = new Set(
  allPlans.flatMap((plan) => plan.phases.flatMap((phase) => phase.notes))
    .filter((id) => posts.some((post) => post.id === id)),
).size;

// The series a plan feeds, in series.ts order, each linked once it has a page.
const feeds = (planId: string) => {
  const plan = planById(planId)!;
  const ids = new Set(plan.phases.flatMap((phase) => phase.series));
  return series.filter((s) => ids.has(s.id)).map((s) => ({
    name: s.name,
    href: publishedIn(posts, s.id) > 0 ? withBase(`/posts/${s.id}/`) : withBase(`/path/#series-${s.id}`),
  }));
};

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const pageUrl = new URL(withBase('/plans/'), siteOrigin).href;
const ogImageUrl = new URL(withBase('/og/plans.png'), siteOrigin).href;

const description = `The ${allPlans.length} plans behind the learning path: the traditional computer science core, the modern developer roadmap, the software AI developer roadmap, the underrated fundamentals, the books, and the plan for each series.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The plans',
  description,
  url: pageUrl,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allPlans.length,
    itemListElement: allPlans.map((plan, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(withBase(`/plans/${plan.id}/`), siteOrigin).href,
      name: entryOf(plan.id).data.title,
    })),
  },
};
---

<SiteLayout
  title="The plans — roadmaps, fundamentals and books behind the learning path"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="The plans behind the learning path"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Plans</span></p>
  <h1>The plans</h1>
  <p class="lead">
    The maps behind the notes. Three roadmaps to the same place, the
    fundamentals under all three, the books, and the plan for each series.
    The notes are the deep dives; these pages are the map.
  </p>

  <ul class="stat-row">
    <li><span class="stat">{allPlans.length}</span> plans</li>
    <li><span class="stat">{phaseCount}</span> phases</li>
    <li><span class="stat">{slotCount}</span> series slots</li>
    <li><span class="stat">{plannedCount}</span> notes planned</li>
    <li><span class="stat">{coveringNotes}</span> published notes on the map</li>
  </ul>

  <p class="series-note">
    How the three roadmaps compare, phase by phase, and where each phase
    lands on this site is on the <a href={withBase('/path/#strategy')}>learning path</a>.
    Every book the plans cite, roadmap by roadmap, is on the <a href={withBase('/books/')}>books page</a>.
  </p>

  {groups.map(({ group, plans }) => (
    <section aria-labelledby={`group-${group.id}`}>
      <h2 id={`group-${group.id}`}>{group.name}</h2>
      <p class="series-note">{group.summary}</p>
      <ul class="roadmap-list">
        {plans.map((plan) => {
          const entry = entryOf(plan.id);
          const fed = feeds(plan.id);
          return (
            <li>
              <h3><a href={withBase(`/plans/${plan.id}/`)}>{entry.data.title}</a></h3>
              <p class="meta">
                {plan.length} · {plan.phases.length} {plan.unit === 'Week' ? 'lenses' : plan.group === 'books' ? 'books' : 'phases'}
                {entry.data.series && <> · the {seriesName(entry.data.series)} series</>}
              </p>
              <p>{entry.data.description}</p>
              <p>
                <em>{plan.question}</em> Best for: {plan.bestFor.toLowerCase()}.
              </p>
              {fed.length > 0 && (
                <p>
                  Notes go to:{' '}
                  {fed.map((s, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={s.href}>{s.name}</a>
                    </>
                  ))}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</SiteLayout>
