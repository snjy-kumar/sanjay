---
import BaseLayout from '../layouts/BaseLayout.astro';
import { typescriptSeries, reactSeries, javascriptSeries } from '../data/series';
import { withBase } from '../utils/base';
---

<BaseLayout title="Sanjay Kumar Thakur" description="Sanjay Kumar Thakur, software engineer in Pune. React, TypeScript, and Node.">
  <a class="skip" href="#work">Skip to work</a>
  <header class="top">
    <p class="name">Sanjay Kumar Thakur</p>
    <p class="where">Pune <span id="clock"></span></p>
  </header>
  <main>
    <h1>Software engineer</h1>
    <p class="lead">I build web apps in React, TypeScript, and Node. The projects below are the ones I want read first.</p>
    <section id="work" aria-labelledby="work-title">
      <h2 id="work-title">Work</h2>
      <article>
        <header>
          <h3><a href="https://github.com/snjy-kumar/url-shortener">URL shortener</a></h3>
          <p class="meta">Next.js · TypeScript · Node · Express · Prisma</p>
        </header>
        <p>Turns a long link into a short one, with a custom slug, a QR code, and click analytics. The front is Next.js. The API is Node, Express, and Prisma, with SQLite in development and Postgres ready for production.</p>
        <p class="note">Auth routes are still placeholders. Analytics falls back to sample data when the API is down. I would ship login before calling the analytics finished.</p>
      </article>
      <article>
        <header>
          <h3><a href="https://github.com/snjy-kumar/task-manager-application">Task manager</a></h3>
          <p class="meta">React · TypeScript · Node · Express · MongoDB</p>
        </header>
        <p>A signed-in task list: priorities, due dates, overdue flags, and a dashboard of counts. React and TypeScript on Vite, Node and Express on MongoDB, JWT on the API.</p>
        <p class="live"><a href="https://task-manager-application-pi.vercel.app">Open the live app</a></p>
      </article>
      <article>
        <header>
          <h3><a href="https://github.com/snjy-kumar/AFOCE">AFOCE</a></h3>
          <p class="meta">React · TypeScript · Node · Express · Prisma · Postgres</p>
        </header>
        <p>Adaptive Financial Operations and Compliance Engine. A React and TypeScript client on Vite, and a Node and Express API with Prisma, Postgres, and background jobs.</p>
        <p class="live"><a href="https://afoce.vercel.app">Open the live app</a></p>
      </article>
    </section>
  </main>
  <section id="series" aria-labelledby="series-title">
    <h2 id="series-title">LinkedIn series</h2>
    <p class="series-note">Wrong-vs-right cards, one a day. Dates already passed are marked published.</p>
    
    <section class="series" aria-labelledby="ts">
      <h2 id="ts">{typescriptSeries.name}</h2>
      <p class="span">{typescriptSeries.dateRange}</p>
      <ul class="journey">
        {typescriptSeries.posts.map(post => (
          <li class={post.published ? 'past' : 'ahead'}>
            <p class="when">
              <time datetime={post.date}>{post.dateShort}</time>
              <span class="state">{post.published ? 'published' : 'scheduled'}</span>
            </p>
            <p class="post">
              {post.published && post.slug ? (
                <a href={withBase(`/posts/typescript/${post.slug}/`)}>{post.title}</a>
              ) : (
                post.title
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="series" aria-labelledby="react">
      <h2 id="react">{reactSeries.name}</h2>
      <p class="span">{reactSeries.dateRange}</p>
      <ul class="journey">
        {reactSeries.posts.map(post => (
          <li class={post.published ? 'past' : 'ahead'}>
            <p class="when">
              <time datetime={post.date}>{post.dateShort}</time>
              <span class="state">{post.published ? 'published' : 'scheduled'}</span>
            </p>
            <p class="post">
              {post.published && post.slug ? (
                <a href={withBase(`/posts/react/${post.slug}/`)}>{post.title}</a>
              ) : (
                post.title
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="series" aria-labelledby="js">
      <h2 id="js">{javascriptSeries.name}</h2>
      <p class="span">{javascriptSeries.dateRange}</p>
      <ul class="journey">
        {javascriptSeries.posts.map(post => (
          <li class={post.published ? 'past' : 'ahead'}>
            <p class="when">
              <time datetime={post.date}>{post.dateShort}</time>
              <span class="state">{post.published ? 'published' : 'scheduled'}</span>
            </p>
            <p class="post">
              {post.published && post.slug ? (
                <a href={withBase(`/posts/javascript/${post.slug}/`)}>{post.title}</a>
              ) : (
                post.title
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <footer>
    <a href="https://github.com/snjy-kumar">GitHub</a>
    <p>Written by hand in HTML, CSS, and JS.</p>
  </footer>

  <script>
    // Runs once when first loaded; astro:page-load re-runs start() after every
    // client-side navigation (see <ClientRouter /> in BaseLayout) so the clock
    // finds the freshly-swapped #clock element. Guards keep a single interval.
    (function () {
      const w = window as any;

      function tick() {
        const clock = document.getElementById('clock');
        if (!clock) return;
        const time = new Intl.DateTimeFormat('en-IN', {
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
          timeZone: 'Asia/Kolkata',
        }).format(new Date());
        clock.textContent = '· ' + time;
      }

      function start() {
        tick();
        if (!w.__clockInterval) {
          w.__clockInterval = setInterval(tick, 30000);
        }
      }

      start();
      if (!w.__clockHooked) {
        w.__clockHooked = true;
        window.addEventListener('astro:page-load', start);
      }
    })();
  </script>
</BaseLayout>
