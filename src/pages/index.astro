---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { series } from '../data/series';
import { withBase } from '../utils/base';
import { profile } from '../data/site';
import { markFor } from '../data/seriesMarks';
import { noteHref, seriesName, shortDate } from '../utils/notes';

const blogPosts = await getCollection('blog');
const plans = await getCollection('plans');

const allPublishedNotes = [...blogPosts].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentNotes = allPublishedNotes.slice(0, 5);

const activeSeries = series.filter((s) =>
  blogPosts.some((post) => post.data.series === s.id),
);

const ogImageUrl = new URL(withBase('/og/home.png'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: new URL(withBase('/'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: [
    profile.github,
    ...(profile.linkedin ? [profile.linkedin] : []),
  ].filter((href) => href.startsWith('http')),
};
---

<SiteLayout
  title={profile.name}
  description={`${profile.name}, ${profile.role} in ${profile.location}. Selected engineering work, technical writing series, and curriculum roadmaps.`}
  ogImage={ogImageUrl}
  ogImageAlt={`${profile.name} — ${profile.role}`}
  jsonLd={jsonLd}
>
  <h1>Software engineer</h1>
  <p class="lead">
    I build web apps in React, TypeScript, and Node. Below is my selected work
    and my daily technical notes—written down as I solve real problems, one day at a time.
  </p>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title">Selected work</h2>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/url-shortener">URL shortener</a></h3>
        <p class="meta">Next.js · TypeScript · Node · Express · Prisma</p>
      </header>
      <p>Turns a long link into a short one, with a custom slug, a QR code, and click analytics. The front is Next.js. The API is Node, Express, and Prisma, with SQLite in development and Postgres ready for production.</p>
      <p class="note">Auth routes are still placeholders. Analytics falls back to sample data when the API is down. I would ship login before calling the analytics finished.</p>
    </article>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/task-manager-application">Task manager</a></h3>
        <p class="meta">React · TypeScript · Node · Express · MongoDB</p>
      </header>
      <p>A signed-in task list: priorities, due dates, overdue flags, and a dashboard of counts. React and TypeScript on Vite, Node and Express on MongoDB, JWT on the API.</p>
      <p class="live"><a href="https://task-manager-application-pi.vercel.app">Open the live app</a></p>
    </article>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/AFOCE">AFOCE</a></h3>
        <p class="meta">React · TypeScript · Node · Express · Prisma · Postgres</p>
      </header>
      <p>Adaptive Financial Operations and Compliance Engine. A React and TypeScript client on Vite, and a Node and Express API with Prisma, Postgres, and background jobs.</p>
      <p class="live"><a href="https://afoce.vercel.app">Open the live app</a></p>
    </article>
  </section>

  <section id="series" aria-labelledby="series-title">
    <h2 id="series-title">Engineering series</h2>
    <p class="series-note">
      Daily wrong-vs-right notes. Each note begins with a failure mode and explores the real solution.
    </p>

    <div class="series-card-grid">
      {activeSeries.map((s) => {
        const publishedCount = blogPosts.filter((p) => p.data.series === s.id).length;
        return (
          <article class="series-overview-card">
            <header class="series-card-head">
              <svg class="series-mark" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={markFor(s.id)} />
              </svg>
              <div>
                <h3><a href={withBase(`/posts/${s.id}/`)}>{s.name}</a></h3>
                <p class="meta">{publishedCount} of {s.posts.length} published · {s.dateRange}</p>
              </div>
            </header>
            <p class="series-desc">{s.description}</p>
            <p class="series-card-action">
              <a href={withBase(`/posts/${s.id}/`)}>Browse {s.name} notes ({publishedCount}) →</a>
            </p>
          </article>
        );
      })}
    </div>

    <div class="recent-notes-block">
      <h3>Recent notes</h3>
      <ul class="journey">
        {recentNotes.map((note) => (
          <li class="past">
            <p class="when">
              <time datetime={note.data.date.toISOString().slice(0, 10)}>
                {shortDate(note.data.date)}
              </time>
              <span class="state">{seriesName(note.data.series)}</span>
            </p>
            <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
          </li>
        ))}
      </ul>
      <p class="more-link">
        <a href={withBase('/posts/')}>Browse all {blogPosts.length} notes across all series →</a>
      </p>
    </div>
  </section>

  <section id="plans" aria-labelledby="plans-title">
    <h2 id="plans-title">Curriculum & engineering roadmaps</h2>
    <p class="series-note">
      Comprehensive curricula published before notes are written. Architectural mental models, core CS, and enduring fundamentals.
    </p>

    <div class="plans-overview-grid">
      {plans.map((plan) => (
        <article class="plan-card">
          <h3><a href={withBase(`/plans/${plan.id}/`)}>{plan.data.title}</a></h3>
          <p class="meta">{plan.data.series ? seriesName(plan.data.series) : 'Engineering Curriculum'}</p>
          <p>{plan.data.description}</p>
          <p class="plan-card-action">
            <a href={withBase(`/plans/${plan.id}/`)}>View syllabus →</a>
          </p>
        </article>
      ))}
    </div>

    <p class="more-link">
      <a href={withBase('/path/')}>View the complete learning tracks & archive →</a>
    </p>
  </section>
</SiteLayout>
