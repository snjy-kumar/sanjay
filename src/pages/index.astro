---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { series } from '../data/series';
import { withBase } from '../utils/base';
import { profile } from '../data/site';
import { counters, notesInSeries } from '../utils/notes';

const blogPosts = await getCollection('blog');

function fileSlug(seriesId: string, seriesOrder: number): string | undefined {
  const match = blogPosts.find(
    (post) => post.data.series === seriesId && post.data.seriesOrder === seriesOrder,
  );
  return match ? match.id.split('/')[1] : undefined;
}

const stats = counters(blogPosts);

// Every series in the timeline, with each planned note linked once its file
// exists. The series with notes published get their own page linked from the
// heading; the ones that have not started yet stay folded away, so the
// homepage shows the plan without becoming a wall of empty rows.
const plannedSeries = series.filter((s) => s.posts.length === 0);

const timelines = series.map((s) => {
  const published = notesInSeries(blogPosts, s.id);
  const done = new Set(published.map((note) => note.data.seriesOrder));

  const posts = s.posts.map((post, index) => ({
    ...post,
    slug: fileSlug(s.id, index + 1),
  }));

  // The next note in the plan that has not been written yet.
  const nextIndex = s.posts.findIndex((_, index) => !done.has(index + 1));
  const next = nextIndex === -1 ? null : s.posts[nextIndex];

  return {
    series: s,
    posts,
    publishedCount: published.length,
    hasPage: published.length > 0,
    next,
  };
});

const ogImageUrl = new URL(withBase('/og/home.png'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: new URL(withBase('/'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: [
    profile.github,
    ...(profile.linkedin ? [profile.linkedin] : []),
  ].filter((href) => href.startsWith('http')),
};
---

<SiteLayout
  title={profile.name}
  description={`${profile.name}, ${profile.role} in ${profile.location}. A learning log in React, TypeScript, JavaScript and Redux — one note a day, in the order I learned it.`}
  ogImage={ogImageUrl}
  ogImageAlt={`${profile.name} — ${profile.role}`}
  jsonLd={jsonLd}
>
  <h1>Software engineer</h1>
  <p class="lead">
    I build web apps in React, TypeScript, and Node. The notes below are the
    other half of that: what I am learning, written down as I learn it, in the
    order it happened.
  </p>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title">Work</h2>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/url-shortener">URL shortener</a></h3>
        <p class="meta">Next.js · TypeScript · Node · Express · Prisma</p>
      </header>
      <p>Turns a long link into a short one, with a custom slug, a QR code, and click analytics. The front is Next.js. The API is Node, Express, and Prisma, with SQLite in development and Postgres ready for production.</p>
      <p class="note">Auth routes are still placeholders. Analytics falls back to sample data when the API is down. I would ship login before calling the analytics finished.</p>
    </article>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/task-manager-application">Task manager</a></h3>
        <p class="meta">React · TypeScript · Node · Express · MongoDB</p>
      </header>
      <p>A signed-in task list: priorities, due dates, overdue flags, and a dashboard of counts. React and TypeScript on Vite, Node and Express on MongoDB, JWT on the API.</p>
      <p class="live"><a href="https://task-manager-application-pi.vercel.app">Open the live app</a></p>
    </article>
    <article>
      <header>
        <h3><a href="https://github.com/snjy-kumar/AFOCE">AFOCE</a></h3>
        <p class="meta">React · TypeScript · Node · Express · Prisma · Postgres</p>
      </header>
      <p>Adaptive Financial Operations and Compliance Engine. A React and TypeScript client on Vite, and a Node and Express API with Prisma, Postgres, and background jobs.</p>
      <p class="live"><a href="https://afoce.vercel.app">Open the live app</a></p>
    </article>
  </section>

  <section id="series" aria-labelledby="series-title">
    <h2 id="series-title">Learning log</h2>
    <p class="series-note">
      Wrong-vs-right notes, one a day. Each one starts from something that
      broke. A note is linked once its page is published.
    </p>

    <ul class="stat-row">
      <li><span class="stat">{stats.notes}</span> notes</li>
      <li><span class="stat">{stats.series}</span> series started</li>
      <li><span class="stat">{stats.days}</span> days</li>
      <li><span class="stat">{stats.streak}</span> day streak</li>
      <li><a href={withBase('/path/')}>the whole path →</a></li>
    </ul>

    {timelines.filter(({ series: s }) => s.posts.length > 0).map(({ series: s, posts, publishedCount, hasPage, next }) =>
      hasPage ? (
        <section class="series" aria-labelledby={`series-${s.id}`}>
          <h2 id={`series-${s.id}`}>
            <a href={withBase(`/posts/${s.id}/`)}>{s.name}</a>
          </h2>
          <p class="span">
            {s.dateRange} · {publishedCount} of {s.posts.length} published
          </p>
          <ul class="journey">
            {posts.map((post) => (
              <li class={post.slug ? 'past' : 'ahead'}>
                <p class="when">
                  <time datetime={post.date}>{post.dateShort}</time>
                  {post.slug && <span class="state">published</span>}
                </p>
                <p class="post">
                  {post.slug ? (
                    <a href={withBase(`/posts/${s.id}/${post.slug}/`)}>{post.title}</a>
                  ) : (
                    post.title
                  )}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <details class="series series-planned">
          <summary>
            <span class="planned-name">{s.name}</span>
            <span class="span">
              {s.dateRange} · {s.posts.length} notes planned
              {next && <> · next: {next.dateShort}</>}
            </span>
          </summary>
          <ul class="journey">
            {posts.map((post) => (
              <li class="ahead">
                <p class="when">
                  <time datetime={post.date}>{post.dateShort}</time>
                </p>
                <p class="post">{post.title}</p>
              </li>
            ))}
          </ul>
        </details>
      ),
    )}

    {plannedSeries.length > 0 && (
      <section class="series" aria-labelledby="planned-series-title">
        <h2 id="planned-series-title">Dedicated series, not started</h2>
        <p class="series-note">
          Each of these has a series slot and a description. No notes are
          written or scheduled yet.
        </p>
        <ul class="journey">
          {plannedSeries.map((s) => (
            <li class="ahead">
              <p class="when">{s.dateRange}</p>
              <p class="post"><strong>{s.name}</strong></p>
              <p class="desc">{s.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="series-note">
      The <a href={withBase('/path/')}>learning path</a> has every note in
      order, the <a href={withBase('/topics/')}>topic pages</a> group them by
      subject, and the <a href={withBase('/log/')}>raw log</a> is what the
      sessions actually looked like.
    </p>
  </section>
</SiteLayout>
