---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/base';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Return to Sanjay Kumar Thakur's blog — engineering notes on TypeScript, React, and JavaScript."
>
  <a class="skip" href="#missing">Skip to content</a>
  <header class="top">
    <p class="name">Sanjay Kumar Thakur</p>
    <p class="where">404</p>
  </header>
  <main id="missing">
    <h1>Page not found</h1>
    <p class="lead">
      This URL doesn't exist — a wrong link, or a post that moved. The
      homepage has the work and the series journey.
    </p>
    <p class="live"><a href={withBase('/')}>Back to the homepage</a></p>
  </main>
  <footer>
    <a href="https://github.com/snjy-kumar">GitHub</a>
    <p>Sanjay Kumar Thakur</p>
  </footer>
</BaseLayout>
