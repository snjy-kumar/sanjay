---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { topicBySlug } from '../../data/tags';
import { withBase } from '../../utils/base';
import { notesWithTopic, topicHref, usedTopics } from '../../utils/notes';

const posts = await getCollection('blog');
const slugs = usedTopics(posts);

const rows = slugs.map((slug) => {
  const topic = topicBySlug(slug)!;
  const notes = notesWithTopic(posts, slug);
  const seriesNames = [...new Set(notes.map((note) => note.data.series))];
  return { topic, count: notes.length, seriesCount: seriesNames.length };
});
---

<SiteLayout
  title="Topics — every subject across the notes"
  description="The subjects the notes cover, from TypeScript types to React effects to JavaScript closures. Each topic page lists every note that mentions it."
  ogImage={new URL(withBase('/og/topics.png'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href}
  ogImageAlt="Every topic the notes cover"
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Topics</span></p>
  <h1>Topics</h1>
  <p class="lead">
    The notes cover the same subjects from different angles. A topic page
    collects every note that mentions it, so a subject can be read across the
    whole stack instead of one language at a time.
  </p>
  <p class="span">{rows.length} topics · {posts.length} notes</p>

  <ul class="topic-index">
    {rows.map(({ topic, count, seriesCount }) => (
      <li>
        <a href={topicHref(topic.slug)}>{topic.label}</a>
        <span class="topic-meta">
          {count} {count === 1 ? 'note' : 'notes'} · {seriesCount}{' '}
          {seriesCount === 1 ? 'series' : 'series'}
        </span>
        <span class="topic-def">{topic.definition}</span>
      </li>
    ))}
  </ul>
</SiteLayout>
