---
// Every book the plans cite, roadmap by roadmap.
//
// The order is the order the work is done in: the traditional core first,
// then the modern developer roadmap, then the software AI developer. A book
// two roadmaps share is listed under each, and says so. The books no
// roadmap names, only the fundamentals or the books plan, come last, by
// shelf. A book links to its page once that page is written.
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { books, shelves } from '../../data/books';
import { planById } from '../../data/plans';
import { booksForRoadmap, checkBooks, citingPlans, roadmapOrder, roadmapsCiting } from '../../utils/books';
import { withBase } from '../../utils/base';

const pages = await getCollection('books');
checkBooks(pages.map((page) => page.id));
const written = new Set(pages.map((page) => page.id));

const roadmaps = roadmapOrder.map((id) => ({
  plan: planById(id)!,
  rows: booksForRoadmap(id),
}));

const onARoadmap = new Set(roadmaps.flatMap(({ rows }) => rows.map(({ book }) => book.slug)));
const offRoadmap = shelves
  .map((shelf) => ({ shelf, books: books.filter((book) => book.shelf === shelf.id && !onARoadmap.has(book.slug)) }))
  .filter(({ books: list }) => list.length > 0);

const otherCites = (slug: string, planId: string) => {
  const book = books.find((b) => b.slug === slug)!;
  return citingPlans(book).filter((cite) => cite.plan !== planId);
};

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const pageUrl = new URL(withBase('/books/'), siteOrigin).href;
const description = `The ${books.length} books the plans cite, roadmap by roadmap: the traditional computer science core, the modern developer, the software AI developer, and the fundamentals under all three. Each one, chapter by chapter, from beginner to system design.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The books',
  description,
  url: pageUrl,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: books.length,
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: book.title,
      ...(written.has(book.slug) ? { url: new URL(withBase(`/books/${book.slug}/`), siteOrigin).href } : {}),
    })),
  },
};
---

<SiteLayout
  title="The books — every book the plans cite, chapter by chapter"
  description={description}
  ogImage={new URL(withBase('/og/books.png'), siteOrigin).href}
  ogImageAlt="The books behind the learning path"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Books</span></p>
  <h1>The books</h1>
  <p class="lead">
    Every book the plans name, in the order I work through them: roadmap by
    roadmap, phase by phase. Each book page goes chapter by chapter, and
    each chapter climbs the same nine levels, from beginner to strategy.
  </p>

  <ul class="stat-row">
    <li><span class="stat">{books.length}</span> books</li>
    <li><span class="stat">{written.size}</span> written up</li>
    <li><span class="stat">{books.filter((book) => roadmapsCiting(book).length > 1).length}</span> shared by two roadmaps or more</li>
  </ul>

  <p class="series-note">
    The plans these come from are on the <a href={withBase('/plans/')}>plans page</a>;
    how the roadmaps compare is on the <a href={withBase('/path/#strategy')}>learning path</a>.
  </p>

  {roadmaps.map(({ plan, rows }) => (
    <section aria-labelledby={`roadmap-${plan.id}`}>
      <h2 id={`roadmap-${plan.id}`}>{plan.label}</h2>
      <p class="series-note">
        {rows.length} {rows.length === 1 ? 'book' : 'books'} from the <a href={withBase(`/plans/${plan.id}/`)}>plan</a>, by the phase that first needs it.
      </p>
      <ol class="book-list">
        {rows.map(({ book, phases }) => {
          const others = otherCites(book.slug, plan.id);
          return (
            <li>
              <span class="book-when">{phases.length > 0 ? `phase ${phases.join(', ')}` : 'reference'}</span>
              <span class="book-what">
                {written.has(book.slug) ? (
                  <a href={withBase(`/books/${book.slug}/`)}>{book.title}</a>
                ) : (
                  <span>{book.title}</span>
                )}
                <span class="meta"> · {book.author}{!written.has(book.slug) && ' · page not written yet'}</span>
                {others.length > 0 && (
                  <span class="book-also">Also: {others.map((c) => c.phases.length > 0 ? `${c.label}, ${c.phases.join(', ')}` : c.label).join('; ')}</span>
                )}
              </span>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <section aria-labelledby="off-roadmap">
    <h2 id="off-roadmap">Under all three roadmaps</h2>
    <p class="series-note">
      The books only the <a href={withBase('/plans/underrated-fundamentals/')}>fundamentals</a> or
      the <a href={withBase('/plans/books-that-still-matter/')}>books plan</a> name, by shelf.
    </p>
    {offRoadmap.map(({ shelf, books: list }) => (
      <>
        <h3 id={`shelf-${shelf.id}`}>{shelf.name}</h3>
        <p class="series-note">{shelf.summary}</p>
        <ol class="book-list">
          {list.map((book) => (
            <li>
              <span class="book-when">{citingPlans(book).flatMap((c) => c.phases).join(', ') || 'named'}</span>
              <span class="book-what">
                {written.has(book.slug) ? (
                  <a href={withBase(`/books/${book.slug}/`)}>{book.title}</a>
                ) : (
                  <span>{book.title}</span>
                )}
                <span class="meta"> · {book.author}{!written.has(book.slug) && ' · page not written yet'}</span>
                <span class="book-also">From: {citingPlans(book).map((c) => c.label).join('; ')}</span>
              </span>
            </li>
          ))}
        </ol>
      </>
    ))}
  </section>
</SiteLayout>
