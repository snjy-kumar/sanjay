---
// One book, chapter by chapter. The body is the MDX in src/content/books/;
// this page adds the parts every book page shares: where the book sits on
// the roadmaps, how its chapter list was checked, the contents, and the way
// back. See docs/BOOK_PAGE_GUIDE.md.
//
// Once a book has chapter pages (src/content/chapters/<slug>/), its MDX is
// the overview, the learning strategy and how I would learn it, and this
// page adds the chapter list under it, every chapter linked. A book with
// chapter pages and no MDX yet still gets a page: the chapter list alone,
// so no chapter is ever orphaned. See docs/CHAPTER_PAGE_GUIDE.md.
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { bookBySlug, shelves } from '../../data/books';
import { checkBooks, citingPlans, planHref, roadmapsCiting } from '../../utils/books';
import { planById } from '../../data/plans';
import { withBase } from '../../utils/base';
import { noteHref } from '../../utils/notes';
import {
  bookPageSlugs,
  chapterHref,
  chapterLabel,
  chaptersByPart,
  chaptersOf,
  checkChapters,
} from '../../utils/chapters';

export async function getStaticPaths() {
  const pages = await getCollection('books');
  const chapters = await getCollection('chapters');
  checkBooks(pages.map((page) => page.id));
  checkChapters(chapters);
  return [...bookPageSlugs(pages, chapters)].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const entry = await getEntry('books', slug);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const book = bookBySlug(slug)!;
const chapters = chaptersOf(await getCollection('chapters'), slug);
const chapterGroups = chaptersByPart(chapters);

const title = entry?.data.title ?? `${book.title}, chapter by chapter`;
const description =
  entry?.data.description ??
  `${book.title} by ${book.author}, one page per chapter, each explained in depth from beginner to system design, in my own words.`;
const shelf = shelves.find((s) => s.id === book.shelf)!;
const cites = citingPlans(book);
const roadmaps = roadmapsCiting(book);

const posts = await getCollection('blog');
const notes = (entry?.data.notes ?? [])
  .map((id) => posts.find((post) => post.id === id))
  .filter((note): note is (typeof posts)[number] => Boolean(note));

// The contents: each h2, with the chapters (h3) under it.
const contents: { slug: string; text: string; children: { slug: string; text: string }[] }[] = [];
for (const heading of headings) {
  if (heading.depth === 2) contents.push({ slug: heading.slug, text: heading.text, children: [] });
  else if (heading.depth === 3 && contents.length > 0) {
    contents[contents.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}
if (chapters.length > 0) contents.push({ slug: 'chapters', text: 'Chapters', children: [] });

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const pageUrl = new URL(withBase(`/books/${book.slug}/`), siteOrigin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageUrl,
  inLanguage: 'en',
  ...(entry ? { datePublished: entry.data.date.toISOString() } : {}),
  about: {
    '@type': 'Book',
    name: book.title,
    author: book.author,
    ...(entry ? { bookEdition: entry.data.edition } : {}),
    ...(chapters.length > 0
      ? {
          hasPart: chapters.map((chapter) => ({
            '@type': 'Chapter',
            name: chapter.data.title,
            position: chapter.data.number,
            url: new URL(chapterHref(chapter), siteOrigin).href,
          })),
        }
      : {}),
  },
  isPartOf: {
    '@type': 'CollectionPage',
    name: 'The books',
    url: new URL(withBase('/books/'), siteOrigin).href,
  },
  author: {
    '@type': 'Person',
    name: 'Sanjay Kumar Thakur',
    url: new URL(withBase('/'), siteOrigin).href,
  },
};
---

<SiteLayout
  title={title}
  description={description}
  ogImage={new URL(withBase(`/og/books/${book.slug}.png`), siteOrigin).href}
  ogImageAlt={`${book.title}, chapter by chapter`}
  jsonLd={jsonLd}
>
  <p class="crumb">
    <a href={withBase('/')}>Home</a> /
    <a href={withBase('/books/')}>Books</a> /
    <span>{book.title}</span>
  </p>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
  <p class="span">{book.author}{entry && ` · ${entry.data.edition}`} · {shelf.name}</p>

  <section class="book-where" aria-labelledby="where-it-sits">
    <h2 id="where-it-sits">Where it sits</h2>
    <ul class="book-cites">
      {cites.map((cite) => (
        <li>
          <a href={planHref(cite.plan)}>{cite.label}</a>
          {cite.phases.length > 0 && <span class="meta"> · {cite.phases.join(', ')}</span>}
        </li>
      ))}
    </ul>
    {roadmaps.length > 1 && (
      <p class="series-note">Shared by {roadmaps.length} roadmaps: {roadmaps.map((id) => planById(id)!.label).join(', ')}.</p>
    )}
    {entry ? (
      <p class="series-note book-toc-note">
        {entry.data.tocVerified ? (
          <>The chapter list follows the {entry.data.edition}, checked against </>
        ) : (
          <>The chapter list could not be checked against an official table of contents, so this page follows the book's known parts instead. Sources looked at: </>
        )}
        {entry.data.tocSources.map((src, i) => (
          <>{i > 0 && ', '}<a href={src}>{new URL(src).hostname.replace(/^www\./, '')}</a></>
        ))}.
        Everything below is my own paraphrase and my own examples; read the book for the author's words.
      </p>
    ) : (
      <p class="series-note book-toc-note">
        The overview and the learning strategy for this book are not written yet; the chapters below are.
        Everything in them is my own paraphrase and my own examples; read the book for the author's words.
      </p>
    )}
  </section>

  {contents.length > 0 && (
    <nav class="book-contents" aria-labelledby="book-contents">
      <h2 id="book-contents">Contents</h2>
      <ol>
        {contents.map((item) => (
          <li>
            <a href={`#${item.slug}`}>{item.text}</a>
            {item.children.length > 0 && (
              <ol>
                {item.children.map((child) => <li><a href={`#${child.slug}`}>{child.text}</a></li>)}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  {Content && (
    <div class="entry book">
      <Content />
    </div>
  )}

  {chapters.length > 0 && (
    <section class="chapter-list" aria-labelledby="chapters" data-chapter-list>
      <h2 id="chapters">Chapters</h2>
      <p class="series-note">
        Each chapter has its own page, written like a textbook chapter: every section explained from first
        principles, with worked examples, diagrams, the nine levels, exercises, and how I would study it.
        {chapters.length === 1 ? ' One chapter is written so far.' : ` ${chapters.length} chapters are written so far.`}
      </p>
      {chapterGroups.map((group) => (
        <>
          {group.part && <h3>{group.part}</h3>}
          <ol>
            {group.chapters.map((chapter) => (
              <li>
                <span class="chapter-n">{chapterLabel(chapter)}</span>
                <span>
                  <a href={chapterHref(chapter)}>{chapter.data.title}</a>
                  <span class="chapter-about">{chapter.data.description}</span>
                </span>
              </li>
            ))}
          </ol>
        </>
      ))}
    </section>
  )}

  {notes.length > 0 && (
    <section aria-labelledby="book-notes">
      <h2 id="book-notes">Notes on this site that go with it</h2>
      <ul class="book-cites">
        {notes.map((note) => <li><a href={noteHref(note)}>{note.data.title}</a></li>)}
      </ul>
    </section>
  )}

  <p class="series-pager">
    <a href={withBase('/books/')}>All the books</a>
    {cites.map((cite) => <a href={planHref(cite.plan)}>{cite.label}</a>)}
  </p>
</SiteLayout>
