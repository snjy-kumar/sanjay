---
// One chapter of a book, on its own page, at
// /books/<book>/<nn>-<chapter-slug>/. The body is the MDX in
// src/content/chapters/<book>/<nn>.mdx; this page adds the crumb, the one
// h1, the rail of chapters, the overview of the h2 sections and the walk to
// the previous and next chapter. See docs/CHAPTER_PAGE_GUIDE.md.
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../../../layouts/ChapterLayout.astro';
import { bookBySlug } from '../../../data/books';
import { withBase } from '../../../utils/base';
import {
  chapterBook,
  chapterHref,
  chapterLabel,
  chapterNumber,
  chapterSlug,
  chaptersOf,
  checkChapters,
  type ChapterEntry,
} from '../../../utils/chapters';

export async function getStaticPaths() {
  const all = await getCollection('chapters');
  checkChapters(all);
  return all.map((chapter) => {
    const siblings = chaptersOf(all, chapterBook(chapter));
    const index = siblings.findIndex((entry) => entry.id === chapter.id);
    return {
      params: { book: chapterBook(chapter), chapter: chapterSlug(chapter) },
      props: {
        chapter,
        siblings,
        prev: index > 0 ? siblings[index - 1] : null,
        next: index < siblings.length - 1 ? siblings[index + 1] : null,
      },
    };
  });
}

interface Props {
  chapter: ChapterEntry;
  siblings: ChapterEntry[];
  prev: ChapterEntry | null;
  next: ChapterEntry | null;
}

const { chapter, siblings, prev, next } = Astro.props;
const { Content, headings } = await render(chapter);
const book = bookBySlug(chapterBook(chapter))!;
const label = chapterLabel(chapter);

// A rough count of the prose: imports, tags and markdown marks removed.
const words = (chapter.body ?? '')
  .replace(/^import .*$/gm, '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#*_`|>{}\[\]()=-]+/g, ' ')
  .split(/\s+/)
  .filter((word) => /[A-Za-z0-9]/.test(word)).length;
const readTime = `${Math.max(1, Math.round(words / 220))} min read`;

const link = (entry: ChapterEntry) => ({
  href: chapterHref(entry),
  title: entry.data.title,
  label: chapterLabel(entry),
});

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const pageUrl = new URL(chapterHref(chapter), siteOrigin).href;
const bookUrl = new URL(withBase(`/books/${book.slug}/`), siteOrigin).href;
const ogImage = new URL(
  withBase(`/og/books/${book.slug}/${chapterNumber(chapter.data.number)}.png`),
  siteOrigin,
).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${chapter.data.title}: ${book.title}, ${label}`,
  description: chapter.data.description,
  url: pageUrl,
  image: ogImage,
  inLanguage: 'en',
  wordCount: words,
  datePublished: chapter.data.date.toISOString(),
  about: {
    '@type': 'Chapter',
    name: chapter.data.title,
    position: chapter.data.number,
    isPartOf: { '@type': 'Book', name: book.title, author: book.author },
  },
  isPartOf: { '@type': 'CollectionPage', name: `${book.title}, chapter by chapter`, url: bookUrl },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Books', item: new URL(withBase('/books/'), siteOrigin).href },
      { '@type': 'ListItem', position: 2, name: book.title, item: bookUrl },
      { '@type': 'ListItem', position: 3, name: chapter.data.title, item: pageUrl },
    ],
  },
  author: {
    '@type': 'Person',
    name: 'Sanjay Kumar Thakur',
    url: new URL(withBase('/'), siteOrigin).href,
  },
};
---

<ChapterLayout
  pageTitle={`${chapter.data.title} · ${book.title}, ${label.toLowerCase()}`}
  title={chapter.data.title}
  description={chapter.data.description}
  label={label}
  part={chapter.data.part}
  book={{ slug: book.slug, title: book.title, author: book.author }}
  chapters={siblings.map((entry) => ({ ...link(entry), current: entry.id === chapter.id }))}
  sections={headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ slug, text }))}
  readTime={readTime}
  words={words}
  ogImage={ogImage}
  jsonLd={jsonLd}
  prev={prev ? link(prev) : null}
  next={next ? link(next) : null}
>
  <div class="entry book chapter-body" data-chapter-body>
    <Content />
  </div>
</ChapterLayout>
