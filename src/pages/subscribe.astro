---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/base';

const feedUrl = new URL(
  withBase('/rss.xml'),
  Astro.site ?? new URL('https://snjy-kumar.github.io'),
).href;
---

<BaseLayout
  title="Follow the series"
  description="Subscribe to the daily React, TypeScript and JavaScript notes. One note a day, in your own feed reader."
  ogImage={new URL(withBase('/og/home.png'), Astro.site ?? new URL('https://snjy-kumar.github.io')).href}
  ogImageAlt="Sanjay Kumar Thakur — software engineer"
>
  <a class="skip" href="#follow">Skip to the feed address</a>
  <header class="top">
    <p class="name"><a href={withBase('/')}>Sanjay Kumar Thakur</a></p>
    <p class="where">Pune</p>
  </header>
  <main class="follow">
    <h1>Follow the series</h1>
    <p class="lead">One note a day on React, TypeScript and JavaScript — a habit that bites, and what to do instead.</p>

    <p>
      Every note goes out as a page here, and the same note is in the feed. Any reader
      can follow it: copy the address below and paste it into your reader of choice —
      NetNewsWire, Folo, Inoreader, or the feed add-on in your browser. The feed
      carries the whole note, so you can read it in the app without opening the site.
    </p>

    <div class="feed-box">
      <div class="codeblock">
        <div class="codeblock-label">Feed address</div>
        <pre><code>{feedUrl}</code></pre>
      </div>
    </div>

    <p class="feed-links">
      <a href={withBase('/rss.xml')}>Open the raw feed</a>
      <span aria-hidden="true"> · </span>
      <a href={withBase('/#series')}>See the notes</a>
      <span aria-hidden="true"> · </span>
      <a href={withBase('/')}>Work</a>
    </p>
  </main>
</BaseLayout>
