---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { series } from '../data/series';
import { withBase } from '../utils/base';
import {
  counters,
  noteHref,
  notesByMonth,
  notesInSeries,
  publishedIn,
  seriesName,
  shortDate,
} from '../utils/notes';

const posts = await getCollection('blog');
const plans = await getCollection('plans');
const stats = counters(posts);

const tracks = series
  .filter((s) => s.posts.length > 0)
  .map((s) => {
    const published = publishedIn(posts, s.id);
    const inSeries = notesInSeries(posts, s.id);
    const planned = s.posts.length;
    const done = new Set(inSeries.map((note) => note.data.seriesOrder));

    let next: { title: string; date: string; dateShort: string } | null = null;
    for (let index = 0; index < s.posts.length; index += 1) {
      if (!done.has(index + 1)) {
        next = s.posts[index];
        break;
      }
    }

    return {
      series: s,
      published,
      planned,
      percent: planned ? Math.round((published / planned) * 100) : 0,
      next,
      hasPage: published > 0,
    };
  });

const months = notesByMonth(posts);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase('/og/path.png'), siteOrigin).href;
const pageUrl = new URL(withBase('/path/'), siteOrigin).href;

const description = `Structured engineering curricula and learning tracks by Sanjay Kumar Thakur. ${plans.length} published curricula, ${stats.notes} notes across ${stats.series} active series.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Curriculum & Learning Tracks',
  description,
  url: pageUrl,
  inLanguage: 'en',
};
---

<SiteLayout
  title="Curriculum & Learning Tracks — Sanjay Kumar Thakur"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="Curriculum & Learning Tracks"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Curriculum</span></p>
  <h1>Curriculum & learning tracks</h1>
  <p class="lead">
    Structured engineering curricula and learning roadmaps. Each plan outlines
    core mental models, failure modes, and enduring fundamentals.
  </p>

  <section class="section-group">
    <h2>Published curricula ({plans.length})</h2>
    <div class="plans-overview-grid">
      {plans.map((plan) => (
        <article class="plan-card">
          <h3><a href={withBase(`/plans/${plan.id}/`)}>{plan.data.title}</a></h3>
          <p class="meta">{plan.data.series ? seriesName(plan.data.series) : 'Engineering Curriculum'}</p>
          <p>{plan.data.description}</p>
          <p class="plan-card-action">
            <a href={withBase(`/plans/${plan.id}/`)}>View syllabus →</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-group">
    <h2>Active series progress</h2>
    <div class="track-list">
      {tracks.map(({ series: s, published, planned, percent, next, hasPage }) => (
        <article class="track">
          <header>
            <h3>
              {hasPage ? (
                <a href={withBase(`/posts/${s.id}/`)}>{s.name}</a>
              ) : (
                s.name
              )}
            </h3>
            <p class="meta">{s.dateRange}</p>
          </header>
          <p class="track-count">
            {published} of {planned} notes published
          </p>
          <div class="bar" role="img" aria-label={`${percent}% of the ${s.name} series published`}>
            <span class="bar-fill" style={`width:${percent}%`}></span>
          </div>
          {next && (
            <p class="track-next">
              Next: <strong>{next.title}</strong> — {next.dateShort}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section-group">
    <h2>Notes archive by month</h2>
    {months.map(({ month, notes: monthNotes }) => (
      <section class="month">
        <h3>{month}</h3>
        <ul class="journey">
          {monthNotes.map((note) => (
            <li class="past">
              <p class="when">
                <time datetime={note.data.date.toISOString().slice(0, 10)}>
                  {shortDate(note.data.date)}
                </time>
                <span class="state">{seriesName(note.data.series)}</span>
              </p>
              <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</SiteLayout>
