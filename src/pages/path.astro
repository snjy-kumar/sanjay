---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { roadmap } from '../data/roadmap';
import { withBase } from '../utils/base';
import { seriesName } from '../utils/notes';

const plans = await getCollection('plans');

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase('/og/path.png'), siteOrigin).href;
const pageUrl = new URL(withBase('/path/'), siteOrigin).href;

const description = `Structured engineering curricula and learning roadmaps by Sanjay Kumar Thakur. ${plans.length} published curricula covering computer science, full-stack, AI, fundamentals, and books.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Curriculum & Engineering Roadmaps',
  description,
  url: pageUrl,
  inLanguage: 'en',
};

const topicBookHighlights = [
  { topic: 'Software Design & Complexity', book: 'A Philosophy of Software Design', takeaway: 'Deep modules hide information behind small interfaces; shallow modules amplify changes.' },
  { topic: 'Debugging & Failure Investigation', book: 'Debugging: The 9 Indispensable Rules', takeaway: 'Never guess. Reproduce reliably, divide and conquer, and prove the fix before closing.' },
  { topic: 'Type Systems & Invariants', book: 'Effective TypeScript', takeaway: 'Types are an invariant harness. Wide primitives leak bugs; strict boundaries keep code honest.' },
  { topic: 'Database Internals & SQL', book: 'Use the Index, Luke', takeaway: 'Databases are B-trees and block I/O. Query plans reveal the runtime truth behind slow queries.' },
  { topic: 'Web Transport & Protocols', book: 'High Performance Browser Networking', takeaway: 'Speed is latency and handshake physics (TCP slow start, TLS, HTTP/2 multiplexing).' },
  { topic: 'Operating Systems & Linux CLI', book: 'The Linux Command Line / OSTEP', takeaway: 'Processes, file descriptors, virtual memory, pipes, and signals. Operational fluency.' },
  { topic: 'Testing & Behavioral Specs', book: 'Unit Testing: Principles, Practices, Patterns', takeaway: 'Verify observable business behavior, not private implementation details or fragile mocks.' },
  { topic: 'Distributed Systems & Data', book: 'Designing Data-Intensive Applications', takeaway: 'Tradeoffs behind replication lag, partition tolerance, consensus, and transactions.' },
  { topic: 'Systems Performance', book: 'Systems Performance', takeaway: 'USE method (Utilization, Saturation, Errors) across CPU, memory, and disk block I/O.' },
  { topic: 'Software Architecture', book: 'Fundamentals of Software Architecture', takeaway: 'Evaluating coupling, cohesion, and fitness functions for long-term decisions.' },
];
---

<SiteLayout
  title="Curriculum & Roadmaps — Sanjay Kumar Thakur"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="Curriculum & Roadmaps"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Curriculum</span></p>
  <h1>Curriculum & roadmaps</h1>
  <p class="lead">
    Structured, project-gated curricula designed to build enduring engineering capabilities
    from first principles: core computer science, systems, modern full-stack, and AI architecture.
  </p>

  <section class="section-group">
    <h2>Published curricula ({plans.length})</h2>
    <div class="plans-overview-grid">
      {plans.map((plan) => (
        <article class="plan-card">
          <h3><a href={withBase(`/plans/${plan.id}/`)}>{plan.data.title}</a></h3>
          <p class="meta">{plan.data.series ? seriesName(plan.data.series) : 'Engineering Curriculum'}</p>
          <p>{plan.data.description}</p>
          <p class="plan-card-action">
            <a href={withBase(`/plans/${plan.id}/`)}>View syllabus & interactive outline →</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-group">
    <h2>Book understanding by engineering topic</h2>
    <p class="series-note">
      Books are tools to build specific mental models. Below is how the reading curriculum
      maps directly to engineering disciplines.
    </p>
    <div class="topic-book-grid">
      {topicBookHighlights.map((item) => (
        <div class="topic-book-card">
          <h4>{item.topic}</h4>
          <p class="book-name"><em>{item.book}</em></p>
          <p class="book-takeaway">{item.takeaway}</p>
        </div>
      ))}
    </div>
    <p class="more-link">
      <a href={withBase('/plans/books-that-still-matter/#book-understanding-by-engineering-topic')}>
        Explore the complete topic-wise book guide & verification criteria →
      </a>
    </p>
  </section>

  <section class="section-group">
    <h2>Architectural vision & upcoming roadmaps</h2>
    <p class="series-note">
      These tracks are planned for future engineering deep dives, focusing on infrastructure and scale.
    </p>
    <ul class="roadmap-list">
      {roadmap.map((track) => (
        <li>
          <h3>{track.name}</h3>
          <p class="meta">{track.size}</p>
          <p>{track.why}</p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
