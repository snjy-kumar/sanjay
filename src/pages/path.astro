---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { series } from '../data/series';
import { roadmap } from '../data/roadmap';
import { topicBySlug } from '../data/tags';
import { checkPlans, planById, plans as allPlanData, planGroups, plansForSeries, plansForTrack, roadmapPlans } from '../data/plans';
import PhaseTable from '../components/PhaseTable.astro';
import PlannedNotes from '../components/PlannedNotes.astro';
import { withBase } from '../utils/base';
import {
  byDateDesc,
  counters,
  datedNotes,
  noteHref,
  notesByMonth,
  notesInSeries,
  publishedIn,
  seriesName,
  shortDate,
  topicHref,
  undatedLabel,
  undatedNotes,
  usedTopics,
} from '../utils/notes';

const posts = await getCollection('blog');
const plans = await getCollection('plans');
// Dated notes newest first, then the undated ones in series order.
const notes = [...posts].sort(byDateDesc);
const undated = undatedNotes(posts);
const stats = counters(posts);

// Each series: how much of it is published, and what comes next.
const tracks = series.map((s) => {
  const published = publishedIn(posts, s.id);
  const inSeries = notesInSeries(posts, s.id);
  const planned = s.posts.length;
  const done = new Set(inSeries.map((note) => note.data.seriesOrder));

  // The next note in the plan that has no file yet.
  let next: { title: string; date: string; dateShort: string } | null = null;
  for (let index = 0; index < s.posts.length; index += 1) {
    if (!done.has(index + 1)) {
      next = s.posts[index];
      break;
    }
  }

  return {
    series: s,
    published,
    planned,
    percent: planned ? Math.round((published / planned) * 100) : 0,
    next,
    hasPage: published > 0,
  };
});

// A series with no dated posts is a dedicated series: undated, each note
// live as soon as it is written. It is shown separately from the daily
// series that have a schedule.
const plannedSeries = series.filter((s) => s.posts.length === 0);
const plannedTotal = plannedSeries.reduce((sum, s) => sum + (s.planned?.length ?? 0), 0);
const undatedWritten = plannedSeries.reduce((sum, s) => sum + publishedIn(posts, s.id), 0);

// The strategy: three roadmaps to the same place, compared phase by phase,
// with the fundamentals and the books underneath. The wiring lives in
// src/data/plans.ts and has to agree with series.ts and roadmap.ts.
checkPlans(plans.map((entry) => entry.id));
const allPlanIds = allPlanData.map((plan) => plan.id);
const planOrder = (id: string) => {
  const index = allPlanIds.indexOf(id);
  return index === -1 ? Number.MAX_SAFE_INTEGER : index;
};
const planEntry = (id: string) => plans.find((entry) => entry.id === id)!;
const groupName = (id: string) => planGroups.find((g) => g.id === planById(id)!.group)!.name;
const underneath = ['underrated-fundamentals', 'books-that-still-matter']
  .map((id) => planById(id))
  .filter((plan) => plan !== undefined);
const destinationsOf = (planId: string) => {
  const plan = planById(planId)!;
  const ids = new Set(plan.phases.flatMap((phase) => phase.series));
  return series.filter((s) => ids.has(s.id));
};
const used = new Set(usedTopics(posts));
// The plans in the order plans.ts gives them, so the list reads from the
// traditional core to the series plans.
const orderedPlans = [...plans].sort(
  (a, b) => planOrder(a.id) - planOrder(b.id),
);

// The subjects, counted. This is the skills map: what the notes actually
// cover, as opposed to what I planned to cover.
const topicRows = usedTopics(posts).map((slug) => {
  const topic = topicBySlug(slug)!;
  const count = posts.filter((note) => note.data.tags.includes(slug)).length;
  const seriesIds = [
    ...new Set(posts.filter((note) => note.data.tags.includes(slug)).map((note) => note.data.series)),
  ];
  return { topic, count, seriesIds };
});

const months = notesByMonth(posts);

const siteOrigin = Astro.site ?? new URL('https://snjy-kumar.github.io');
const ogImageUrl = new URL(withBase('/og/path.png'), siteOrigin).href;
const pageUrl = new URL(withBase('/path/'), siteOrigin).href;

const description = `The whole learning path in one page: ${stats.notes} notes across ${stats.series} series since ${stats.first ? stats.first.toISOString().slice(0, 10) : ''}, the three roadmaps behind them, the subjects they cover, and what comes next.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'The learning path',
  description,
  url: pageUrl,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: stats.notes,
    itemListElement: notes.map((note, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(noteHref(note), siteOrigin).href,
      name: note.data.title,
    })),
  },
};
---

<SiteLayout
  title="The learning path — every note, in order"
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt="The learning path"
  jsonLd={jsonLd}
>
  <p class="crumb"><a href={withBase('/')}>Home</a> / <span>Learning path</span></p>
  <h1>The learning path</h1>
  <p class="lead">
    Everything I have written, in the order I wrote it. The notes are the
    curriculum: each one starts from something that broke, and each series
    ends where the next one begins.
  </p>

  <ul class="stat-row">
    <li><span class="stat">{stats.notes}</span> notes</li>
    <li><span class="stat">{stats.series}</span> series started</li>
    <li><span class="stat">{stats.days}</span> days</li>
    <li><span class="stat">{stats.weeks}</span> weeks</li>
    <li><span class="stat">{stats.streak}</span> day streak</li>
    <li><span class="stat">{stats.thisWeek}</span> this week</li>
  </ul>

  <h2>The series</h2>
  <div class="track-list">
    {tracks
      .filter(({ planned, published }) => planned > 0 || published > 0)
      .map(({ series: s, published, planned, percent, next, hasPage }) => (
        <article class="track" id={`series-${s.id}`}>
          <header>
            <h3>
              {hasPage ? (
                <a href={withBase(`/posts/${s.id}/`)}>{s.name}</a>
              ) : (
                s.name
              )}
            </h3>
            <p class="meta">{s.dateRange}</p>
          </header>
          <p class="track-count">
            {published} of {planned} notes published
          </p>
          <div class="bar" role="img" aria-label={`${percent}% of the ${s.name} series published`}>
            <span class="bar-fill" style={`width:${percent}%`}></span>
          </div>
          {next && (
            <p class="track-next">
              Next: <strong>{next.title}</strong> — {next.dateShort}
            </p>
          )}
        </article>
      ))}
  </div>

  <h2 id="strategy">The learning strategy</h2>
  <p class="series-note">
    Three roadmaps go to the same place by different roads. The traditional
    core starts from how computation works. The modern path starts from a
    page in the browser and ships something at the end of every phase. The
    software AI developer path assumes the basics and goes deep on owning an
    AI-native product. Each phase ends in a gate: something I can do without
    notes, or I go back. Every book the roadmaps cite, phase by phase, is
    on the <a href={withBase('/books/')}>books page</a>.
  </p>
  <p class="series-note">
    The order on this site is a spiral: use the abstraction, then open it.
    TypeScript and React come before the JavaScript series because that is
    the order the bugs arrived in. The roadmaps are the map; the series are
    the deep dives, and every phase lands in a series slot or a track below.
  </p>

  <div class="entry plan">
    <table>
      <thead>
        <tr>
          <th scope="col">Roadmap</th>
          <th scope="col">The question</th>
          <th scope="col">Best for</th>
          <th scope="col">Length</th>
          <th scope="col">Notes go to</th>
        </tr>
      </thead>
      <tbody>
        {roadmapPlans.map((plan) => (
          <tr>
            <td><a href={withBase(`/plans/${plan.id}/`)}>{plan.label}</a></td>
            <td>{plan.question}</td>
            <td>{plan.bestFor}</td>
            <td>{plan.length}, {plan.phases.length} phases</td>
            <td>{destinationsOf(plan.id).map((s) => s.name).join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {roadmapPlans.map((plan) => (
    <section class="month" id={`roadmap-${plan.id}`}>
      <h3><a href={withBase(`/plans/${plan.id}/`)}>{plan.label}</a></h3>
      <p class="span">{groupName(plan.id)} · {plan.length} · {plan.question}</p>
      <PhaseTable plan={plan} posts={posts} />
    </section>
  ))}

  {underneath.length > 0 && (
    <>
      <p class="series-note">
        Under all three roadmaps, whichever one is being followed:
      </p>
      <ul class="roadmap-list">
        {underneath.map((plan) => (
          <li>
            <h3><a href={withBase(`/plans/${plan.id}/`)}>{planEntry(plan.id).data.title}</a></h3>
            <p class="meta">{plan.length}</p>
            <p>{planEntry(plan.id).data.description}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {plannedSeries.length > 0 && (
    <>
      <h2 id="planned">Dedicated series</h2>
      <p class="series-note">
        These series are undated. A note in one of them goes live as soon as
        it is written, with no day attached, so it sits in its series rather
        than in the timeline. The {plannedTotal} rows below are the notes the
        plans call for; {undatedWritten} of them are written and linked, and
        the rest say not written yet.
      </p>
      <ul class="roadmap-list">
        {plannedSeries.map((s) => {
          const from = plansForSeries(s.id);
          return (
            <li id={`series-${s.id}`}>
              <h3>{publishedIn(posts, s.id) > 0 ? <a href={withBase(`/posts/${s.id}/`)}>{s.name}</a> : s.name}</h3>
              <p class="meta">
                {s.dateRange}
                {s.planned && s.planned.length > 0 && <> · {publishedIn(posts, s.id)} of {s.planned.length} written</>}
              </p>
              <p>{s.description}</p>
              {s.topics.length > 0 && (
                <p>
                  Topics:{' '}
                  {s.topics.map((slug, i) => (
                    <>
                      {i > 0 && ', '}
                      {used.has(slug)
                        ? <a href={topicHref(slug)}>{topicBySlug(slug)?.label ?? slug}</a>
                        : topicBySlug(slug)?.label ?? slug}
                    </>
                  ))}
                </p>
              )}
              {from.length > 0 && (
                <p>
                  From:{' '}
                  {from.map((plan, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={withBase(`/plans/${plan.id}/`)}>{plan.label}</a>
                    </>
                  ))}
                </p>
              )}
              <PlannedNotes series={s} />
            </li>
          );
        })}
      </ul>
    </>
  )}

  <h2>What the notes cover</h2>
  <p class="series-note">
    The subjects the notes actually reach, counted. Each one is a page of its
    own with every note that mentions it.
  </p>
  <ul class="topic-list topic-list-wide">
    {topicRows.map(({ topic, count, seriesIds }) => (
      <li>
        <a href={topicHref(topic.slug)}>{topic.label}</a>
        <span class="topic-meta">
          {count} · {seriesIds.map((id) => seriesName(id)).join(', ')}
        </span>
      </li>
    ))}
  </ul>

  <h2>Everything, in order</h2>
  {months.map(({ month, notes: monthNotes }) => (
    <section class="month">
      <h3>{month}</h3>
      <ul class="journey">
        {monthNotes.map((note) => (
          <li class="past">
            <p class="when">
              <time datetime={note.data.date!.toISOString().slice(0, 10)}>
                {shortDate(note.data.date!)}
              </time>
              <span class="state">{seriesName(note.data.series)}</span>
            </p>
            <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {undated.length > 0 && (
    <section class="month">
      <h3>Undated, by series</h3>
      <ul class="journey">
        {undated.map((note) => (
          <li class="past">
            <p class="when">
              {undatedLabel(note)}
              <span class="state">{seriesName(note.data.series)}</span>
            </p>
            <p class="post"><a href={noteHref(note)}>{note.data.title}</a></p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <h2>What is next</h2>
  <p class="series-note">
    These are planned, not written. Nothing here is published yet, so it is
    listed as an intention rather than a promise.
  </p>
  <ul class="roadmap-list">
    {roadmap.map((track) => (
      <li id={`track-${track.id}`}>
        <h3>{track.name}</h3>
        <p class="meta">{track.size}</p>
        <p>{track.why}</p>
        {plansForTrack(track.id).length > 0 && (
          <p>
            From:{' '}
            {plansForTrack(track.id).map((plan, i) => (
              <>
                {i > 0 && ', '}
                <a href={withBase(`/plans/${plan.id}/`)}>{plan.label}</a>
              </>
            ))}
          </p>
        )}
      </li>
    ))}
  </ul>

  {plans.length > 0 && (
    <>
      <h2>The plans</h2>
      <p class="series-note">
        The curriculum behind a series, published before the notes are
        written. A note is a plan that survived contact with a real failure.
        The <a href={withBase('/plans/')}>plans index</a> groups them by kind.
      </p>
      <ul class="roadmap-list">
        {orderedPlans.map((plan) => (
          <li>
            <h3><a href={withBase(`/plans/${plan.id}/`)}>{plan.data.title}</a></h3>
            <p class="meta">
              {plan.data.series
                ? `The ${seriesName(plan.data.series)} series`
                : planById(plan.id) ? groupName(plan.id) : 'Plan'}
            </p>
            <p>{plan.data.description}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</SiteLayout>
